<?xml version='1.0' encoding='utf-8'?>
<resources>
    <style name="CryonixTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/cryonix_background_2</item>
        <item name="colorPrimaryDark">@color/cryonix_background</item>
        <item name="colorAccent">@color/cryonix_accent</item>
        <item name="android:textColorPrimary">@color/cryonix_text</item>
        <item name="android:textColorSecondary">@color/cryonix_text_secondary</item>
        <item name="android:windowBackground">@color/cryonix_background</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/cryonix_background</item>
        <item name="android:navigationBarColor">@color/cryonix_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="alertDialogTheme">@style/CryonixDialogTheme</item>
        <item name="android:alertDialogTheme">@style/CryonixDialogTheme</item>
    </style>

    <style name="CryonixDialogTheme" parent="@style/Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="colorAccent">@color/cryonix_accent</item>
        <item name="android:textColorPrimary">@color/cryonix_text</item>
        <item name="android:textColorSecondary">@color/cryonix_text_secondary</item>
        <item name="android:windowMinWidthMajor">56%</item>
        <item name="android:windowMinWidthMinor">68%</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.62</item>
    </style>

    <style name="CryonixIconNavButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:background">@drawable/bg_cryonix_nav</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="CryonixHeaderIconButton">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:background">@drawable/bg_cryonix_nav</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">@color/cryonix_icon</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="LauncherFragment_Divider">
        <item name="android:layout_width">@dimen/padding_tiny</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="ThickDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_1sdp</item>
        <item name="android:background">?android:attr/listDivider</item>
    </style>

    <item name="dimension_tracker" type="id" />
    <style name="DimensionTracker">
        <item name="android:id">@id/dimension_tracker</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>
</resources>
