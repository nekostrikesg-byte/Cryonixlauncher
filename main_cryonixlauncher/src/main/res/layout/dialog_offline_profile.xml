<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/offline_dialog_card"
    android:layout_width="520dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp"
    android:background="@drawable/bg_pojav_row">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create Local Profile"
        android:textColor="@color/cryonix_text"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Offline profile"
        android:textColor="@color/cryonix_text_secondary"
        android:textSize="12sp"/>

    <EditText
        android:id="@+id/offline_profile_name"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_pojav_row"
        android:hint="Profile name"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="@color/cryonix_text"
        android:textColorHint="@color/cryonix_muted"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/offline_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Cancel"
            android:textColor="@color/cryonix_text_secondary"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/offline_create"
            android:layout_width="150dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:background="@drawable/bg_pojav_button"
            android:text="Create"
            android:textColor="@color/cryonix_button_text"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>