<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cryonix_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/accounts_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:tint="@color/cryonix_icon"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Accounts"
            android:textColor="@color/cryonix_text"
            android:textSize="22sp"/>

        <ImageButton
            android:id="@+id/accounts_add"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Add account"
            android:padding="8dp"
            android:src="@drawable/ic_plus"
            android:tint="@color/cryonix_icon"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/accounts_current_card"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:background="@drawable/bg_reference_card"
        android:gravity="center_vertical"
        android:padding="18dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_accounts"
            android:tint="@color/cryonix_icon"
            android:contentDescription="Profile"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="18dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Local account"
                android:textColor="@color/cryonix_text_secondary"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/accounts_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Player"
                android:textColor="@color/cryonix_text"
                android:textSize="20sp"/>

            <TextView
                android:id="@+id/accounts_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Offline profile"
                android:textColor="@color/cryonix_text_secondary"
                android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selected"
            android:textColor="@color/cryonix_accent"
            android:textSize="13sp"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Add Account"
        android:textColor="@color/cryonix_text"
        android:textSize="18sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_reference_row"
        android:padding="18dp"
        android:text="Microsoft account sign-in is not connected yet. Local/offline profiles can be used for the launcher UI."
        android:textColor="@color/cryonix_text_secondary"
        android:textSize="14sp"/>

    <TextView
        android:id="@+id/accounts_add_button"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_reference_launch"
        android:gravity="center"
        android:text="Create Local Profile"
        android:textColor="@color/cryonix_button_text"
        android:textSize="16sp"/>
</LinearLayout>