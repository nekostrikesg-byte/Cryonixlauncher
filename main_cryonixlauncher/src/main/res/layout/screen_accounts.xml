<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/cryonix_background"
    android:padding="12dp">

    <LinearLayout android:layout_width="52dp" android:layout_height="match_parent" android:gravity="center_horizontal" android:orientation="vertical" android:background="@drawable/bg_reference_pill" android:paddingTop="8dp">
        <ImageButton android:id="@+id/accounts_back" android:layout_width="42dp" android:layout_height="42dp" android:background="@android:color/transparent" android:contentDescription="Back" android:padding="10dp" android:src="@drawable/ic_back" android:tint="@color/cryonix_icon"/>
        <ImageButton android:layout_width="42dp" android:layout_height="42dp" android:layout_marginTop="4dp" android:background="@drawable/bg_reference_launch" android:contentDescription="Accounts" android:padding="10dp" android:src="@drawable/ic_accounts" android:tint="@color/cryonix_button_text"/>
    </LinearLayout>

    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:paddingStart="14dp" android:gravity="center_vertical">

        <LinearLayout android:id="@+id/accounts_current_card" android:layout_width="0dp" android:layout_height="132dp" android:layout_weight="1" android:background="@drawable/bg_reference_card" android:padding="14dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PLAYER BADGE" android:textColor="@color/cryonix_muted" android:textSize="8sp" android:letterSpacing="0.12"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOCAL" android:textColor="@color/cryonix_text_secondary" android:textSize="8sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
                <View android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_reference_launch"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="9dp" android:orientation="vertical">
                    <TextView android:id="@+id/accounts_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Player" android:textColor="@color/cryonix_text" android:textSize="15sp"/>
                    <TextView android:id="@+id/accounts_id" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="OFFLINE" android:textColor="@color/cryonix_text_secondary" android:textSize="8sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="ACCESS  •  LOCAL PROFILE" android:textColor="@color/cryonix_muted" android:textSize="7sp"/>
                </LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="16dp" android:text="C:S LAUNCHER PLUS        NO PASSPORT" android:textColor="@color/cryonix_muted" android:textSize="6sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="132dp" android:layout_weight="1.35" android:layout_marginStart="10dp" android:background="@drawable/bg_reference_card" android:padding="14dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Just a local profile" android:textColor="@color/cryonix_text" android:textSize="14sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 / 6" android:textColor="@color/cryonix_muted" android:textSize="8sp"/>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Skip the name or add one. Settings are stored locally." android:textColor="@color/cryonix_text_secondary" android:textSize="8sp"/>
            <EditText android:id="@+id/accounts_profile_name" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="7dp" android:background="@drawable/bg_reference_row" android:hint="player_name" android:paddingStart="10dp" android:paddingEnd="10dp" android:textColor="@color/cryonix_text" android:textColorHint="@color/cryonix_muted" android:textSize="11sp" android:singleLine="true"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="3 – 16 characters   •   letters, numbers, underscore" android:textColor="@color/cryonix_muted" android:textSize="7sp"/>
            <TextView android:id="@+id/accounts_add_button" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="7dp" android:background="@drawable/bg_reference_launch" android:gravity="center" android:text="CREATE PROFILE" android:textColor="@color/cryonix_button_text" android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>