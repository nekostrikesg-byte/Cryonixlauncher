<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="@color/cryonix_background" android:padding="10dp">

    <LinearLayout android:layout_width="54dp" android:layout_height="match_parent" android:gravity="center_horizontal"
        android:orientation="vertical" android:background="@drawable/bg_reference_pill" android:paddingTop="8dp">
        <TextView android:id="@+id/accounts_back" android:layout_width="44dp" android:layout_height="44dp"
            android:gravity="center" android:text="‹" android:textSize="26sp" android:textColor="@color/cryonix_icon"
            android:background="@android:color/transparent" android:contentDescription="Back"/>
        <ImageButton android:layout_width="44dp" android:layout_height="44dp" android:layout_marginTop="4dp"
            android:background="@drawable/bg_reference_launch" android:contentDescription="Accounts"
            android:padding="10dp" android:src="@drawable/ic_accounts" android:tint="@color/cryonix_button_text"/>
    </LinearLayout>

    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="12dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Accounts"
                android:textColor="@color/cryonix_text" android:textSize="20sp" android:textStyle="bold"/>
            <TextView android:id="@+id/accounts_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:text="No local profiles" android:textColor="@color/cryonix_text_secondary" android:textSize="9sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:orientation="vertical" android:paddingEnd="6dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Saved profiles"
                    android:textColor="@color/cryonix_text_secondary" android:textSize="10sp"/>
                <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:layout_marginTop="6dp" android:scrollbars="none">
                    <LinearLayout android:id="@+id/accounts_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                </ScrollView>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.15"
                android:layout_marginStart="6dp" android:orientation="vertical" android:paddingStart="6dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Add account"
                    android:textColor="@color/cryonix_text" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                    android:text="Use a local profile for launcher configuration, or connect Microsoft authentication when the backend is configured."
                    android:textColor="@color/cryonix_text_secondary" android:textSize="9sp"/>

                <EditText android:id="@+id/accounts_profile_name" android:layout_width="match_parent" android:layout_height="44dp"
                    android:layout_marginTop="10dp" android:background="@drawable/bg_reference_row" android:hint="player_name"
                    android:paddingStart="12dp" android:paddingEnd="12dp" android:textColor="@color/cryonix_text"
                    android:textColorHint="@color/cryonix_muted" android:textSize="11sp" android:singleLine="true"/>

                <TextView android:id="@+id/accounts_add_button" android:layout_width="match_parent" android:layout_height="42dp"
                    android:layout_marginTop="7dp" android:background="@drawable/bg_reference_launch" android:gravity="center"
                    android:text="CREATE LOCAL PROFILE" android:textColor="@color/cryonix_button_text" android:textSize="10sp"/>

                <TextView android:id="@+id/accounts_microsoft_button" android:layout_width="match_parent" android:layout_height="42dp"
                    android:layout_marginTop="7dp" android:background="@drawable/bg_reference_row" android:gravity="center"
                    android:text="SIGN IN WITH MICROSOFT" android:textColor="@color/cryonix_text_secondary" android:textSize="10sp"/>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp"
                    android:text="Microsoft login is intentionally not simulated. This build has no OAuth client/session provider yet."
                    android:textColor="@color/cryonix_muted" android:textSize="8sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>