<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:background="@color/cryonix_surface">
    <TextView android:id="@+id/version_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/cryonix_text" android:textSize="16sp" android:textStyle="bold"/>
    <TextView android:id="@+id/version_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/cryonix_text_secondary" android:textSize="12sp"/>
</LinearLayout>