<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp" android:background="@color/cryonix_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center">
<LinearLayout android:layout_width="330dp" android:layout_height="46dp" android:background="@drawable/bg_nav" android:gravity="center" android:padding="4dp">
<TextView android:id="@+id/instance_detail_back" android:layout_width="52dp" android:layout_height="38dp" android:gravity="center" android:text="‹" android:textColor="@color/cryonix_icon" android:textSize="24sp"/>
<ImageView android:layout_width="52dp" android:layout_height="38dp" android:background="@drawable/bg_nav_selected" android:padding="10dp" android:src="@drawable/ic_cube" android:tint="@color/cryonix_button_text"/>
<ImageView android:layout_width="52dp" android:layout_height="38dp" android:padding="10dp" android:src="@drawable/ic_accounts" android:tint="@color/cryonix_icon"/>
<ImageView android:layout_width="52dp" android:layout_height="38dp" android:padding="10dp" android:src="@drawable/ic_download" android:tint="@color/cryonix_icon"/>
<ImageView android:layout_width="52dp" android:layout_height="38dp" android:padding="10dp" android:src="@drawable/ic_settings" android:tint="@color/cryonix_icon"/>
<ImageView android:layout_width="52dp" android:layout_height="38dp" android:padding="10dp" android:src="@drawable/ic_home" android:tint="@color/cryonix_icon"/>
</LinearLayout></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:paddingTop="8dp">
<LinearLayout android:layout_width="180dp" android:layout_height="match_parent" android:orientation="vertical" android:paddingEnd="7dp">
<TextView android:layout_width="match_parent" android:layout_height="42dp" android:text="INSTANCE" android:textColor="@color/cryonix_muted" android:textSize="8sp" android:gravity="center_vertical"/>
<TextView android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_nav_selected" android:gravity="center_vertical" android:paddingStart="12dp" android:text="Overview" android:textColor="@color/cryonix_button_text" android:textSize="10sp"/>
<TextView android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="5dp" android:background="@drawable/bg_reference_row" android:gravity="center_vertical" android:paddingStart="12dp" android:text="Versions" android:textColor="@color/cryonix_text" android:textSize="10sp"/>
<TextView android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="5dp" android:background="@drawable/bg_reference_row" android:gravity="center_vertical" android:paddingStart="12dp" android:text="Mods &amp; Packs" android:textColor="@color/cryonix_text" android:textSize="10sp"/>
<TextView android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="5dp" android:background="@drawable/bg_reference_row" android:gravity="center_vertical" android:paddingStart="12dp" android:text="Servers" android:textColor="@color/cryonix_text" android:textSize="10sp"/>
</LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:paddingStart="7dp">
<TextView android:id="@+id/instance_detail_title" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:text="Instance" android:textColor="@color/cryonix_text" android:textSize="20sp" android:textStyle="bold"/>
<TextView android:id="@+id/instance_detail_summary" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/bg_reference_card" android:gravity="center_vertical" android:padding="16dp" android:textColor="@color/cryonix_text" android:textSize="10sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp">
<TextView android:id="@+id/instance_detail_launch" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_reference_launch" android:gravity="center" android:text="LAUNCH" android:textColor="@color/cryonix_button_text" android:textSize="9sp"/>
<TextView android:id="@+id/instance_detail_edit" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:background="@drawable/bg_reference_row" android:gravity="center" android:text="EDIT" android:textColor="@color/cryonix_text" android:textSize="9sp"/>
<TextView android:id="@+id/instance_detail_duplicate" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:background="@drawable/bg_reference_row" android:gravity="center" android:text="DUPLICATE" android:textColor="@color/cryonix_text" android:textSize="9sp"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="6dp">
<TextView android:id="@+id/instance_detail_servers" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_reference_row" android:gravity="center" android:text="SERVER HUB" android:textColor="@color/cryonix_text" android:textSize="9sp"/>
<TextView android:id="@+id/instance_detail_delete" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:background="@drawable/bg_reference_row" android:gravity="center" android:text="DELETE" android:textColor="@color/cryonix_text_secondary" android:textSize="9sp"/>
</LinearLayout>
</LinearLayout></LinearLayout>
</LinearLayout>