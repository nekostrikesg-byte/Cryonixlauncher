<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cryonix_background"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical">
        <TextView android:id="@+id/instance_detail_back" android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bg_cryonix_row" android:gravity="center" android:text="‹" android:textColor="@color/cryonix_icon" android:textSize="22sp" android:contentDescription="Back"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="INSTANCE OVERVIEW" android:textColor="@color/cryonix_text_secondary" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.1"/>
        <TextView android:layout_width="wrap_content" android:layout_height="30dp" android:background="@drawable/bg_cryonix_row" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="JAVA EDITION" android:textColor="@color/cryonix_accent_soft" android:textSize="8sp" android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="10dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:layout_width="176dp" android:layout_height="match_parent" android:background="@drawable/bg_cryonix_row" android:orientation="vertical" android:padding="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="24dp" android:gravity="center_vertical" android:text="INSTANCE" android:textColor="@color/cryonix_muted" android:textSize="8sp" android:textStyle="bold" android:letterSpacing="0.1"/>
            <TextView android:layout_width="match_parent" android:layout_height="40dp" android:background="@drawable/bg_cryonix_button" android:gravity="center_vertical" android:paddingStart="10dp" android:text="Overview" android:textColor="@color/cryonix_button_text" android:textSize="10sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="5dp" android:background="@android:color/transparent" android:gravity="center_vertical" android:paddingStart="10dp" android:text="Versions" android:textColor="@color/cryonix_text_secondary" android:textSize="10sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="3dp" android:background="@android:color/transparent" android:gravity="center_vertical" android:paddingStart="10dp" android:text="Mods &amp; packs" android:textColor="@color/cryonix_text_secondary" android:textSize="10sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="3dp" android:background="@android:color/transparent" android:gravity="center_vertical" android:paddingStart="10dp" android:text="Servers" android:textColor="@color/cryonix_text_secondary" android:textSize="10sp"/>
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Profile settings remain managed by the current launcher." android:textColor="@color/cryonix_muted" android:textSize="8sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/instance_detail_title" android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:text="Instance" android:textColor="@color/cryonix_text" android:textSize="21sp" android:textStyle="bold"/>
            <TextView android:id="@+id/instance_detail_summary" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="5dp" android:layout_weight="1" android:background="@drawable/bg_card" android:gravity="center_vertical" android:padding="17dp" android:textColor="@color/cryonix_text" android:textSize="10sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="8dp">
                <TextView android:id="@+id/instance_detail_launch" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:background="@drawable/bg_cryonix_button" android:gravity="center" android:text="LAUNCH" android:textColor="@color/cryonix_button_text" android:textSize="9sp" android:textStyle="bold"/>
                <TextView android:id="@+id/instance_detail_edit" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_cryonix_row" android:gravity="center" android:text="EDIT" android:textColor="@color/cryonix_text" android:textSize="9sp"/>
                <TextView android:id="@+id/instance_detail_duplicate" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_cryonix_row" android:gravity="center" android:text="DUPLICATE" android:textColor="@color/cryonix_text" android:textSize="9sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="37dp" android:layout_marginTop="5dp">
                <TextView android:id="@+id/instance_detail_servers" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_cryonix_row" android:gravity="center" android:text="SERVER HUB" android:textColor="@color/cryonix_text_secondary" android:textSize="8sp"/>
                <TextView android:id="@+id/instance_detail_delete" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_cryonix_row" android:gravity="center" android:text="DELETE" android:textColor="@color/cryonix_text_secondary" android:textSize="8sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
