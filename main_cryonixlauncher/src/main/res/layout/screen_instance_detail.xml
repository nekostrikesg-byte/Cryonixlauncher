<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@color/cryonix_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
<TextView android:id="@+id/instance_detail_back" android:layout_width="70dp" android:layout_height="40dp" android:gravity="center" android:text="‹ Back" android:textColor="@color/cryonix_text" android:background="@drawable/bg_reference_pill"/>
<TextView android:id="@+id/instance_detail_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="Instance" android:textColor="@color/cryonix_text" android:textSize="19sp" android:textStyle="bold"/>
</LinearLayout>
<TextView android:id="@+id/instance_detail_summary" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:padding="14dp" android:gravity="center_vertical" android:background="@drawable/bg_reference_card" android:textColor="@color/cryonix_text" android:textSize="11sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:orientation="horizontal">
<TextView android:id="@+id/instance_detail_launch" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:text="LAUNCH" android:textColor="@color/cryonix_button_text" android:background="@drawable/bg_reference_launch" android:textSize="10sp"/>
<TextView android:id="@+id/instance_detail_edit" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center" android:text="EDIT" android:textColor="@color/cryonix_text" android:background="@drawable/bg_reference_row" android:textSize="10sp"/>
<TextView android:id="@+id/instance_detail_duplicate" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center" android:text="DUPLICATE" android:textColor="@color/cryonix_text" android:background="@drawable/bg_reference_row" android:textSize="10sp"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
<TextView android:id="@+id/instance_detail_servers" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:gravity="center" android:text="SERVER HUB" android:textColor="@color/cryonix_text" android:background="@drawable/bg_reference_row" android:textSize="10sp"/>
<TextView android:id="@+id/instance_detail_delete" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center" android:text="DELETE" android:textColor="@color/cryonix_text_secondary" android:background="@drawable/bg_reference_row" android:textSize="10sp"/>
</LinearLayout>
</LinearLayout>