<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding"
    android:background="@color/cryonix_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/all_apps"
        android:textColor="@color/cryonix_text"
        android:textSize="28sp"
        android:textStyle="bold"/>

    <EditText
        android:id="@+id/apps_search"
        android:layout_width="match_parent"
        android:layout_height="@dimen/control_height"
        android:layout_marginTop="16dp"
        android:hint="@string/search_apps"
        android:background="@color/cryonix_surface"
        android:paddingHorizontal="18dp"
        android:textColor="@color/cryonix_text"
        android:textColorHint="@color/cryonix_text_secondary"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/apps_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"/>
</LinearLayout>