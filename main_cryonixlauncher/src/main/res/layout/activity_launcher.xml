<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cryonix_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:background="@color/cryonix_top"
            android:paddingStart="18dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/home_accounts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="+  Add account"
                android:textColor="@color/cryonix_text"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/home_versions"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:contentDescription="Instances"
                android:padding="9dp"
                android:src="@drawable/ic_cube"
                android:tint="@color/cryonix_text" />

            <ImageButton
                android:id="@+id/home_refresh"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:contentDescription="Downloads"
                android:padding="9dp"
                android:src="@drawable/ic_download"
                android:tint="@color/cryonix_text" />

            <ImageButton
                android:id="@+id/home_settings"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:contentDescription="Settings"
                android:padding="9dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/cryonix_text" />

            <ImageButton
                android:id="@+id/home_home"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:contentDescription="Home"
                android:padding="8dp"
                android:src="@drawable/ic_home"
                android:tint="@color/cryonix_text" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/cryonix_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="300dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Instances"
                        android:textColor="@color/cryonix_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/home_instance_count"
                        android:layout_width="32dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_simple_row"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/cryonix_cyan"
                        android:textSize="10sp" />
                </LinearLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:id="@+id/home_instances_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <TextView
                    android:id="@+id/home_add_instance"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_blue_outline"
                    android:gravity="center"
                    android:text="+  NEW INSTANCE"
                    android:textColor="@color/cryonix_cyan"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/cryonix_logo"
                    android:contentDescription="Cryonix" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="CRYONIX"
                    android:textColor="@color/cryonix_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JAVA MINECRAFT • ANDROID"
                    android:textColor="@color/cryonix_text_secondary"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/home_profile"
                    android:layout_width="220dp"
                    android:layout_height="38dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_simple_row"
                    android:gravity="center"
                    android:text="●  Player  •  Local profile"
                    android:textColor="@color/cryonix_text"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/home_runtime"
                    android:layout_width="220dp"
                    android:layout_height="34dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_simple_row"
                    android:gravity="center"
                    android:text="Java 8  •  2048 MB  •  System"
                    android:textColor="@color/cryonix_text_secondary"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/home_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="No installed versions"
                    android:textColor="@color/cryonix_cyan"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/home_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ready"
                    android:textColor="@color/cryonix_muted"
                    android:textSize="7sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="220dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:text="QUICK LINKS"
                    android:textColor="@color/cryonix_muted"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/home_youtube"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_simple_row"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:text="YouTube"
                    android:textColor="@color/cryonix_text"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/home_discord"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_simple_row"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:text="Discord"
                    android:textColor="@color/cryonix_text"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_simple_row"
                    android:padding="11dp"
                    android:text="Fast launch&#10;Persistent instances&#10;Real download tasks&#10;Runtime preflight"
                    android:textColor="@color/cryonix_text_secondary"
                    android:textSize="8sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:background="@color/cryonix_top"
            android:paddingStart="18dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_grass_block"
                android:contentDescription="Selected instance" />

            <TextView
                android:id="@+id/home_selected_label"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:text="1.12.2"
                android:textColor="@color/cryonix_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/home_launch"
                android:layout_width="140dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_reference_launch"
                android:gravity="center"
                android:text="PLAY"
                android:textColor="@color/cryonix_button_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/task_manager_panel"
        android:layout_width="330dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_reference_card"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/task_manager_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Launch Tasks"
                android:textColor="@color/cryonix_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/task_manager_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_reference_pill"
                android:gravity="center"
                android:text="×"
                android:textColor="@color/cryonix_text"
                android:textSize="19sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/task_manager_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Preparing launch metadata…"
            android:textColor="@color/cryonix_accent_soft"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/task_manager_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="7dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/cryonix_accent" />

        <TextView
            android:id="@+id/task_manager_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_reference_row"
            android:padding="9dp"
            android:text="Version: not selected&#10;Profile: Player&#10;Loader: vanilla&#10;Renderer: system"
            android:textColor="@color/cryonix_text"
            android:textSize="9sp" />

        <ProgressBar
            android:id="@+id/task_manager_progress_bottom"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/cryonix_accent" />

        <TextView
            android:id="@+id/task_manager_percent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:layout_marginTop="4dp"
            android:text="0%"
            android:textColor="@color/cryonix_accent"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
