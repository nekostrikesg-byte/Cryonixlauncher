<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cryonix_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:background="@color/cryonix_top"
            android:paddingStart="24dp"
            android:paddingEnd="18dp">

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:background="@drawable/bg_pojav_button"
                android:text="C"
                android:textColor="@color/cryonix_button_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CRYONIXLAUNCHER PLUS"
                    android:textColor="@color/cryonix_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MINECRAFT JAVA EDITION • ANDROID"
                    android:textColor="@color/cryonix_text_secondary"
                    android:textSize="9sp"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <TextView
                android:id="@+id/home_accounts"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_pojav_row"
                android:text="+  Add account"
                android:textColor="@color/cryonix_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/home_profile"
                android:layout_width="150dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical|end"
                android:paddingEnd="12dp"
                android:text=""
                android:textColor="@color/cryonix_text_secondary"
                android:textSize="10sp" />

            <ImageButton
                android:id="@+id/home_settings"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_pojav_row"
                android:contentDescription="Settings"
                android:padding="10dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/cryonix_text" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/cryonix_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingTop="18dp"
            android:paddingEnd="22dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.15"
                android:orientation="vertical"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR NEXT WORLD"
                    android:textColor="@color/cryonix_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.16" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Ready when\nyou are."
                    android:textColor="@color/cryonix_text"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:lineSpacingMultiplier="0.94" />

                <TextView
                    android:id="@+id/home_feature_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="A cleaner home for your Minecraft Java sessions."
                    android:textColor="@color/cryonix_text_secondary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_pojav_row"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QUICK ACCESS"
                        android:textColor="@color/cryonix_muted"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/home_custom_controls"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:drawableStart="@drawable/ic_controls_simple"
                            android:drawablePadding="9dp"
                            android:text="Controls"
                            android:textColor="@color/cryonix_text"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/home_execute_jar"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:drawableStart="@drawable/ic_jar_simple"
                            android:drawablePadding="9dp"
                            android:text="Run .JAR"
                            android:textColor="@color/cryonix_text"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/cryonix_divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/home_share_log"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:drawableStart="@drawable/ic_share_log_simple"
                            android:drawablePadding="9dp"
                            android:text="Share log"
                            android:textColor="@color/cryonix_text"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/home_open_directory"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:drawableStart="@drawable/ic_folder_simple"
                            android:drawablePadding="9dp"
                            android:text="Game files"
                            android:textColor="@color/cryonix_text"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="16dp"
                android:background="@color/cryonix_divider" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.95"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1.25"
                    android:orientation="vertical"
                    android:background="@drawable/bg_pojav_row"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACTIVE INSTANCE"
                        android:textColor="@color/cryonix_muted"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />

                    <TextView
                        android:id="@+id/home_selected_label"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:paddingTop="6dp"
                        android:text="Choose an instance"
                        android:textColor="@color/cryonix_text"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manage versions, loaders and profiles"
                        android:textColor="@color/cryonix_text_secondary"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="INSTANCES"
                            android:textColor="@color/cryonix_muted"
                            android:textSize="9sp"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/home_instance_count"
                            android:layout_width="36dp"
                            android:layout_height="30dp"
                            android:gravity="center"
                            android:background="@drawable/bg_pojav_button"
                            android:text="0"
                            android:textColor="@color/cryonix_button_text"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/home_edit_profile"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_pojav_row"
                            android:contentDescription="Manage instances"
                            android:padding="9dp"
                            android:src="@drawable/ic_settings"
                            android:tint="@color/cryonix_text" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.75"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_pojav_row"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COMMUNITY"
                        android:textColor="@color/cryonix_muted"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/home_wiki"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:drawableStart="@drawable/ic_wiki"
                            android:drawablePadding="8dp"
                            android:text="Wiki"
                            android:textColor="@color/cryonix_text"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/home_discord"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:drawableStart="@drawable/ic_discord_simple"
                            android:drawablePadding="8dp"
                            android:text="Discord"
                            android:textColor="@color/cryonix_text"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:background="@color/cryonix_top"
            android:paddingStart="22dp"
            android:paddingEnd="22dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@color/cryonix_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:text="CRYONIX PLUS"
                android:textColor="@color/cryonix_text_secondary"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/home_launch"
                android:layout_width="170dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_pojav_button"
                android:gravity="center"
                android:text="▶   PLAY NOW"
                android:textColor="@color/cryonix_button_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/home_instances_list"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/home_add_instance"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:text="+" />

    <LinearLayout
        android:id="@+id/task_manager_panel"
        android:layout_width="330dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_pojav_row"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/task_manager_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Launch Tasks"
                android:textColor="@color/cryonix_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/task_manager_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="×"
                android:textColor="@color/cryonix_text"
                android:textSize="19sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/task_manager_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Preparing launch metadata…"
            android:textColor="@color/cryonix_accent_soft"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/task_manager_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="7dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/cryonix_accent" />

        <TextView
            android:id="@+id/task_manager_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="9dp"
            android:text="Version: not selected&#10;Profile: Player&#10;Loader: vanilla&#10;Renderer: system"
            android:textColor="@color/cryonix_text"
            android:textSize="9sp" />

        <ProgressBar
            android:id="@+id/task_manager_progress_bottom"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/cryonix_accent" />

        <TextView
            android:id="@+id/task_manager_percent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:layout_marginTop="4dp"
            android:text="0%"
            android:textColor="@color/cryonix_accent"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
