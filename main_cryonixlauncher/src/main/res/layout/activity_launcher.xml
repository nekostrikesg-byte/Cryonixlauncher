<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cryonix_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="58dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_reference_pill"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/home_home"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_reference_pill"
                android:contentDescription="Home"
                android:padding="7dp"
                android:src="@drawable/cryonix_logo"/>

            <ImageButton
                android:id="@+id/home_versions"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@android:color/transparent"
                android:contentDescription="Instances"
                android:padding="11dp"
                android:src="@drawable/ic_cube"
                android:tint="@color/cryonix_blue"/>

            <ImageButton
                android:id="@+id/home_accounts"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="3dp"
                android:background="@android:color/transparent"
                android:contentDescription="Accounts"
                android:padding="11dp"
                android:src="@drawable/ic_accounts"
                android:tint="@color/cryonix_icon"/>

            <ImageButton
                android:id="@+id/home_refresh"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="3dp"
                android:background="@android:color/transparent"
                android:contentDescription="Downloads"
                android:padding="11dp"
                android:src="@drawable/ic_download"
                android:tint="@color/cryonix_icon"/>

            <ImageButton
                android:id="@+id/home_settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="3dp"
                android:background="@android:color/transparent"
                android:contentDescription="Settings"
                android:padding="11dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/cryonix_icon"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="Cryonix logo"
                    android:src="@drawable/cryonix_logo"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CRYONIX"
                        android:textColor="@color/cryonix_text"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MINECRAFT LAUNCHER"
                        android:textColor="@color/cryonix_muted"
                        android:textSize="8sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/home_youtube"
                    android:layout_width="70dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_reference_row"
                    android:gravity="center"
                    android:text="YouTube"
                    android:textColor="@color/cryonix_text_secondary"
                    android:textSize="9sp"/>

                <TextView
                    android:id="@+id/home_discord"
                    android:layout_width="68dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_reference_row"
                    android:gravity="center"
                    android:text="Discord"
                    android:textColor="@color/cryonix_text_secondary"
                    android:textSize="9sp"/>

                <TextView
                    android:id="@+id/home_profile"
                    android:layout_width="112dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/bg_reference_pill"
                    android:gravity="center"
                    android:text="●  ishan1  ⌄"
                    android:textColor="@color/cryonix_text"
                    android:textSize="10sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="Cryonix logo"
                    android:src="@drawable/cryonix_logo"/>

                <TextView
                    android:id="@+id/home_launch"
                    android:layout_width="300dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_reference_launch"
                    android:gravity="center"
                    android:text="▶  LAUNCH"
                    android:textColor="@color/cryonix_button_text"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/home_runtime"
                    android:layout_width="220dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_reference_row"
                    android:gravity="center"
                    android:text="Java 8   •   2048 MB RAM"
                    android:textColor="@color/cryonix_text_secondary"
                    android:textSize="9sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="82dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_reference_row"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="INSTANCES"
                            android:textColor="@color/cryonix_text"
                            android:textSize="11sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/home_instance_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/cryonix_muted"
                            android:textSize="10sp"/>

                        <TextView
                            android:id="@+id/home_add_instance"
                            android:layout_width="32dp"
                            android:layout_height="27dp"
                            android:layout_marginStart="7dp"
                            android:background="@drawable/bg_reference_pill"
                            android:gravity="center"
                            android:text="+"
                            android:textColor="@color/cryonix_blue"
                            android:textSize="18sp"/>
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:scrollbars="none"
                        android:overScrollMode="never">

                        <LinearLayout
                            android:id="@+id/home_instances_list"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"/>
                    </HorizontalScrollView>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/home_version"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/home_status"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/task_manager_panel"
        android:layout_width="330dp"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="72dp"
        android:background="@drawable/bg_reference_card"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/task_manager_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Launch Tasks"
                android:textColor="@color/cryonix_text"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/task_manager_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_reference_pill"
                android:gravity="center"
                android:text="×"
                android:textColor="@color/cryonix_text"
                android:textSize="19sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/task_manager_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Preparing launch metadata…"
            android:textColor="@color/cryonix_accent_soft"
            android:textSize="11sp"/>

        <ProgressBar
            android:id="@+id/task_manager_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="7dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/cryonix_accent"/>

        <TextView
            android:id="@+id/task_manager_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_reference_row"
            android:padding="9dp"
            android:text="Version: not selected&#10;Profile: Player&#10;Loader: vanilla&#10;Renderer: system"
            android:textColor="@color/cryonix_text"
            android:textSize="9sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Overall task progress"
                    android:textColor="@color/cryonix_text_secondary"
                    android:textSize="9sp"/>

                <TextView
                    android:id="@+id/task_manager_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8%"
                    android:textColor="@color/cryonix_accent"
                    android:textSize="9sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/task_manager_progress_bottom"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progress="8"
                android:progressTint="@color/cryonix_accent"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>