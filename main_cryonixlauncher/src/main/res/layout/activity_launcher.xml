<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cryonix_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="22dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CryonixLauncher"
            android:textColor="@color/cryonix_text"
            android:textSize="22sp"/>

        <ImageButton
            android:id="@+id/home_versions"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@android:color/transparent"
            android:contentDescription="Versions"
            android:padding="10dp"
            android:src="@drawable/ic_folder"
            android:tint="@color/cryonix_icon"/>

        <ImageButton
            android:id="@+id/home_accounts"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@android:color/transparent"
            android:contentDescription="Accounts"
            android:padding="9dp"
            android:src="@drawable/ic_accounts"
            android:tint="@color/cryonix_icon"/>

        <ImageButton
            android:id="@+id/home_refresh"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@android:color/transparent"
            android:contentDescription="Download and refresh"
            android:padding="10dp"
            android:src="@drawable/ic_download"
            android:tint="@color/cryonix_icon"/>

        <ImageButton
            android:id="@+id/home_settings"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/settings"
            android:padding="10dp"
            android:src="@drawable/ic_settings"
            android:tint="@color/cryonix_icon"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="440dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginTop="82dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_reference_card"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_plus"
                android:contentDescription="Add account"/>

            <TextView
                android:id="@+id/home_add_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Add Account"
                android:textColor="@color/cryonix_text"
                android:textSize="18sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_grass_block"
                android:contentDescription="Minecraft"/>

            <TextView
                android:id="@+id/home_version"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="No installed versions"
                android:textColor="@color/cryonix_text"
                android:textSize="17sp"/>

            <TextView
                android:id="@+id/home_profile"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"/>
        </LinearLayout>

        <TextView
            android:id="@+id/home_status"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/home_launch"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_reference_launch"
            android:gravity="center"
            android:text="Launch"
            android:textColor="@color/cryonix_button_text"
            android:textSize="18sp"/>

    </LinearLayout>
</FrameLayout>