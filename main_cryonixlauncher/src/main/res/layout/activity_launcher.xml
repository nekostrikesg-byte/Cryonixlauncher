<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/cryonix_background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="8dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center">
            <LinearLayout android:layout_width="330dp" android:layout_height="46dp"
                android:background="@drawable/bg_nav" android:gravity="center" android:padding="4dp">
                <ImageButton android:id="@+id/home_versions" android:layout_width="52dp" android:layout_height="38dp"
                    android:background="@drawable/bg_nav_selected" android:contentDescription="Instances" android:padding="10dp"
                    android:src="@drawable/ic_cube" android:tint="@color/cryonix_button_text"/>
                <ImageButton android:id="@+id/home_accounts" android:layout_width="52dp" android:layout_height="38dp" android:layout_marginStart="3dp"
                    android:background="@android:color/transparent" android:contentDescription="Accounts" android:padding="10dp"
                    android:src="@drawable/ic_accounts" android:tint="@color/cryonix_icon"/>
                <ImageButton android:id="@+id/home_refresh" android:layout_width="52dp" android:layout_height="38dp" android:layout_marginStart="3dp"
                    android:background="@android:color/transparent" android:contentDescription="Downloads" android:padding="10dp"
                    android:src="@drawable/ic_download" android:tint="@color/cryonix_icon"/>
                <ImageButton android:id="@+id/home_settings" android:layout_width="52dp" android:layout_height="38dp" android:layout_marginStart="3dp"
                    android:background="@android:color/transparent" android:contentDescription="Settings" android:padding="10dp"
                    android:src="@drawable/ic_settings" android:tint="@color/cryonix_icon"/>
                <ImageButton android:id="@+id/home_home" android:layout_width="52dp" android:layout_height="38dp" android:layout_marginStart="3dp"
                    android:background="@android:color/transparent" android:contentDescription="Home" android:padding="10dp"
                    android:src="@drawable/ic_home" android:tint="@color/cryonix_icon"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">

            <LinearLayout android:layout_width="190dp" android:layout_height="match_parent" android:orientation="vertical" android:paddingEnd="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/cryonix_logo"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical" android:paddingStart="7dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CRYONIX"
                            android:textColor="@color/cryonix_text" android:textSize="13sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="INSTANCES"
                            android:textColor="@color/cryonix_muted" android:textSize="7sp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/home_instance_count" android:layout_width="28dp" android:layout_height="26dp"
                        android:background="@drawable/bg_reference_pill" android:gravity="center" android:text="0"
                        android:textColor="@color/cryonix_accent_soft" android:textSize="9sp"/>
                </LinearLayout>
                <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:scrollbars="none" android:overScrollMode="never">
                    <LinearLayout android:id="@+id/home_instances_list" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:paddingTop="5dp" android:paddingBottom="5dp"/>
                </ScrollView>
                <TextView android:id="@+id/home_add_instance" android:layout_width="match_parent" android:layout_height="38dp"
                    android:layout_marginTop="5dp" android:background="@drawable/bg_blue_outline" android:gravity="center"
                    android:text="+  NEW INSTANCE" android:textColor="@color/cryonix_accent_soft" android:textSize="9sp" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:gravity="center" android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
                <ImageView android:layout_width="72dp" android:layout_height="72dp" android:src="@drawable/cryonix_logo" android:contentDescription="Cryonix"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp"
                    android:text="CRYONIX" android:textColor="@color/cryonix_text" android:textSize="19sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp"
                    android:text="JAVA MINECRAFT • ANDROID" android:textColor="@color/cryonix_muted" android:textSize="7sp"/>
                <TextView android:id="@+id/home_launch" android:layout_width="260dp" android:layout_height="50dp" android:layout_marginTop="14dp"
                    android:background="@drawable/bg_reference_launch" android:gravity="center" android:text="▶  LAUNCH"
                    android:textColor="@color/cryonix_button_text" android:textSize="14sp" android:textStyle="bold"/>
                <TextView android:id="@+id/home_runtime" android:layout_width="210dp" android:layout_height="28dp" android:layout_marginTop="7dp"
                    android:background="@drawable/bg_reference_row" android:gravity="center" android:text="Java 8  •  2048 MB  •  System"
                    android:textColor="@color/cryonix_text_secondary" android:textSize="8sp"/>
                <TextView android:id="@+id/home_version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="No installed versions" android:textColor="@color/cryonix_accent_soft" android:textSize="8sp"/>
                <TextView android:id="@+id/home_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Ready" android:textColor="@color/cryonix_muted" android:textSize="7sp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="190dp" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="8dp">
                <TextView android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical"
                    android:text="PROFILE" android:textColor="@color/cryonix_muted" android:textSize="8sp" android:textStyle="bold"/>
                <TextView android:id="@+id/home_profile" android:layout_width="match_parent" android:layout_height="58dp"
                    android:background="@drawable/bg_reference_card" android:gravity="center_vertical" android:paddingStart="12dp"
                    android:text="●  Player&#10;   Local profile  ⌄" android:textColor="@color/cryonix_text" android:textSize="10sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="8dp"
                    android:gravity="center_vertical" android:text="COMMUNITY" android:textColor="@color/cryonix_muted" android:textSize="8sp" android:textStyle="bold"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="42dp">
                    <TextView android:id="@+id/home_youtube" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:background="@drawable/bg_reference_row" android:gravity="center" android:text="YouTube" android:textColor="@color/cryonix_text" android:textSize="8sp"/>
                    <TextView android:id="@+id/home_discord" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:layout_marginStart="5dp" android:background="@drawable/bg_reference_row" android:gravity="center"
                        android:text="Discord" android:textColor="@color/cryonix_text" android:textSize="8sp"/>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:background="@drawable/bg_reference_row" android:padding="10dp"
                    android:text="NEW • Quick launch&#10;Persistent instances&#10;Task notifications&#10;Runtime preflight"
                    android:textColor="@color/cryonix_text_secondary" android:textSize="8sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/task_manager_panel" android:layout_width="330dp" android:layout_height="wrap_content"
        android:layout_gravity="center" android:background="@drawable/bg_reference_card" android:elevation="8dp"
        android:orientation="vertical" android:padding="14dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/task_manager_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Launch Tasks" android:textColor="@color/cryonix_text" android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:id="@+id/task_manager_close" android:layout_width="32dp" android:layout_height="32dp"
                android:background="@drawable/bg_reference_pill" android:gravity="center" android:text="×" android:textColor="@color/cryonix_text" android:textSize="19sp"/>
        </LinearLayout>
        <TextView android:id="@+id/task_manager_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="Preparing launch metadata…" android:textColor="@color/cryonix_accent_soft" android:textSize="11sp"/>
        <ProgressBar android:id="@+id/task_manager_progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="7dp" android:max="100" android:progress="0" android:progressTint="@color/cryonix_accent"/>
        <TextView android:id="@+id/task_manager_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:background="@drawable/bg_reference_row" android:padding="9dp" android:text="Version: not selected&#10;Profile: Player&#10;Loader: vanilla&#10;Renderer: system"
            android:textColor="@color/cryonix_text" android:textSize="9sp"/>
        <ProgressBar android:id="@+id/task_manager_progress_bottom" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="8dp" android:max="100" android:progress="0" android:progressTint="@color/cryonix_accent"/>
        <TextView android:id="@+id/task_manager_percent" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end"
            android:layout_marginTop="4dp" android:text="0%" android:textColor="@color/cryonix_accent" android:textSize="9sp" android:textStyle="bold"/>
    </LinearLayout>
</FrameLayout>