<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cryonix_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:background="@color/cryonix_top"
            android:paddingStart="18dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/home_accounts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="+  Add account"
                android:textColor="@color/cryonix_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/home_profile"
                android:layout_width="180dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical|end"
                android:paddingEnd="12dp"
                android:text=""
                android:textColor="@color/cryonix_text_secondary"
                android:textSize="9sp" />

            <ImageButton
                android:id="@+id/home_settings"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@android:color/transparent"
                android:contentDescription="Settings"
                android:padding="10dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/cryonix_text" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/cryonix_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingTop="10dp"
                android:paddingEnd="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.15"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/home_wiki"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:drawableStart="@drawable/ic_wiki"
                            android:drawablePadding="14dp"
                            android:gravity="center_vertical"
                            android:text="WIKI"
                            android:textColor="@color/cryonix_text"
                            android:textSize="12sp" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:background="#454545" />

                        <TextView
                            android:id="@+id/home_discord"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:drawableStart="@drawable/ic_discord_simple"
                            android:drawablePadding="14dp"
                            android:gravity="center_vertical"
                            android:paddingStart="18dp"
                            android:text="DISCORD"
                            android:textColor="@color/cryonix_text"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#292929" />

                    <TextView
                        android:id="@+id/home_custom_controls"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:drawableStart="@drawable/ic_controls_simple"
                        android:drawablePadding="14dp"
                        android:gravity="center_vertical"
                        android:text="CUSTOM CONTROLS"
                        android:textColor="@color/cryonix_text"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/home_execute_jar"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:drawableStart="@drawable/ic_jar_simple"
                        android:drawablePadding="14dp"
                        android:gravity="center_vertical"
                        android:text="EXECUTE A .JAR"
                        android:textColor="@color/cryonix_text"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/home_share_log"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:drawableStart="@drawable/ic_share_log_simple"
                        android:drawablePadding="14dp"
                        android:gravity="center_vertical"
                        android:text="SHARE LOG FILE"
                        android:textColor="@color/cryonix_text"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/home_open_directory"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:drawableStart="@drawable/ic_folder_simple"
                        android:drawablePadding="14dp"
                        android:gravity="center_vertical"
                        android:text="OPEN GAME DIRECTORY"
                        android:textColor="@color/cryonix_text"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:textColor="@color/cryonix_muted" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="#303030" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.85"
                    android:gravity="top"
                    android:orientation="vertical"
                    android:paddingTop="4dp">

                    <TextView
                        android:id="@+id/home_feature_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CRYONIX&#10;Android Java launcher"
                        android:textColor="@color/cryonix_text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:background="#202020"
            android:paddingStart="18dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_grass_block"
                android:contentDescription="Selected instance" />

            <TextView
                android:id="@+id/home_selected_label"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:text="1.12.2"
                android:textColor="@color/cryonix_text_secondary"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/home_edit_profile"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:contentDescription="Edit instance"
                android:padding="9dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/cryonix_text" />

            <TextView
                android:id="@+id/home_launch"
                android:layout_width="130dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_pojav_button"
                android:gravity="center"
                android:text="PLAY"
                android:textColor="@color/cryonix_button_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/home_instance_count"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"
                android:text="0" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/home_instances_list"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/home_add_instance"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:text="+" />

    <LinearLayout
        android:id="@+id/task_manager_panel"
        android:layout_width="330dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_pojav_row"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/task_manager_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Launch Tasks"
                android:textColor="@color/cryonix_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/task_manager_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="×"
                android:textColor="@color/cryonix_text"
                android:textSize="19sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/task_manager_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Preparing launch metadata…"
            android:textColor="@color/cryonix_accent_soft"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/task_manager_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="7dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/cryonix_accent" />

        <TextView
            android:id="@+id/task_manager_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="9dp"
            android:text="Version: not selected&#10;Profile: Player&#10;Loader: vanilla&#10;Renderer: system"
            android:textColor="@color/cryonix_text"
            android:textSize="9sp" />

        <ProgressBar
            android:id="@+id/task_manager_progress_bottom"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/cryonix_accent" />

        <TextView
            android:id="@+id/task_manager_percent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:layout_marginTop="4dp"
            android:text="0%"
            android:textColor="@color/cryonix_accent"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>