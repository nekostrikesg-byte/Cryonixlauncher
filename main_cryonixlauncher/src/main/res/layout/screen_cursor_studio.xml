<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@color/cryonix_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
<TextView android:id="@+id/cursor_back" android:layout_width="70dp" android:layout_height="40dp" android:gravity="center" android:text="‹ Back" android:textColor="@color/cryonix_text" android:background="@drawable/bg_cryonix_row"/>
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="Cursor Studio" android:textColor="@color/cryonix_text" android:textSize="19sp" android:textStyle="bold"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Choose a native Android pointer preset. This applies to mouse/trackpad pointers inside Cryonix; Android does not expose custom pointer size/opacity to ordinary apps." android:textColor="@color/cryonix_text_secondary" android:textSize="9sp"/>
<RadioGroup android:id="@+id/cursor_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
<RadioButton android:id="@+id/cursor_arrow" android:layout_width="match_parent" android:layout_height="48dp" android:text="Arrow" android:textColor="@color/cryonix_text"/>
<RadioButton android:id="@+id/cursor_hand" android:layout_width="match_parent" android:layout_height="48dp" android:text="Hand" android:textColor="@color/cryonix_text"/>
<RadioButton android:id="@+id/cursor_text" android:layout_width="match_parent" android:layout_height="48dp" android:text="Text" android:textColor="@color/cryonix_text"/>
<RadioButton android:id="@+id/cursor_crosshair" android:layout_width="match_parent" android:layout_height="48dp" android:text="Crosshair" android:textColor="@color/cryonix_text"/>
</RadioGroup>
<TextView android:id="@+id/cursor_status" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:background="@drawable/bg_cryonix_row" android:paddingStart="12dp" android:text="Ready" android:textColor="@color/cryonix_text_secondary" android:textSize="10sp"/>
</LinearLayout>