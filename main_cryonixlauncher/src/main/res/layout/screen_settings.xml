<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cryonix_background"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="142dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp">

            <ImageButton
                android:id="@+id/settings_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="Back"
                android:padding="8dp"
                android:src="@drawable/ic_back"
                android:tint="@color/cryonix_icon"/>

            <ImageButton
                android:id="@+id/settings_home"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="Home"
                android:padding="8dp"
                android:src="@drawable/ic_home"
                android:tint="@color/cryonix_icon"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settings_nav_renderer"
            android:layout_width="118dp"
            android:layout_height="70dp"
            android:background="@drawable/bg_reference_pill"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_renderer" android:tint="@color/cryonix_icon"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Renderer" android:textColor="@color/cryonix_text" android:textSize="13sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settings_nav_game"
            android:layout_width="118dp"
            android:layout_height="70dp"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_rocket" android:tint="@color/cryonix_icon"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Game" android:textColor="@color/cryonix_text" android:textSize="13sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settings_nav_controls"
            android:layout_width="118dp"
            android:layout_height="70dp"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_gamepad" android:tint="@color/cryonix_icon"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Controls" android:textColor="@color/cryonix_text" android:textSize="13sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settings_nav_gamepad"
            android:layout_width="118dp"
            android:layout_height="70dp"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_gamepad" android:tint="@color/cryonix_icon"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gamepad" android:textColor="@color/cryonix_text" android:textSize="13sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settings_nav_launcher"
            android:layout_width="118dp"
            android:layout_height="70dp"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_cube" android:tint="@color/cryonix_icon"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Launcher" android:textColor="@color/cryonix_text" android:textSize="13sp"/>
        </LinearLayout>

        <View android:layout_width="50dp" android:layout_height="1dp" android:layout_marginTop="6dp" android:background="@color/cryonix_divider"/>
        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_marginTop="16dp" android:src="@drawable/ic_java" android:tint="@color/cryonix_icon"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Settings"
                android:textColor="@color/cryonix_text"
                android:textSize="22sp"/>

            <ImageButton android:id="@+id/settings_versions" android:layout_width="46dp" android:layout_height="46dp" android:background="@android:color/transparent" android:contentDescription="Versions" android:padding="9dp" android:src="@drawable/ic_folder" android:tint="@color/cryonix_icon"/>
            <ImageButton android:id="@+id/settings_accounts" android:layout_width="46dp" android:layout_height="46dp" android:background="@android:color/transparent" android:contentDescription="Accounts" android:padding="8dp" android:src="@drawable/ic_accounts" android:tint="@color/cryonix_icon"/>
            <ImageButton android:id="@+id/settings_download" android:layout_width="46dp" android:layout_height="46dp" android:background="@android:color/transparent" android:contentDescription="Download" android:padding="9dp" android:src="@drawable/ic_download" android:tint="@color/cryonix_icon"/>
            <LinearLayout android:id="@+id/settings_pill" android:layout_width="130dp" android:layout_height="46dp" android:background="@drawable/bg_reference_pill" android:gravity="center_vertical" android:paddingStart="12dp">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_settings" android:tint="@color/cryonix_icon"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Settings" android:textColor="@color/cryonix_text" android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/settings_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <LinearLayout android:id="@+id/settings_section_renderer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:text="Renderer" android:textColor="@color/cryonix_text" android:textSize="20sp"/>
                    <FrameLayout android:id="@+id/settings_global_renderer" android:layout_width="match_parent" android:layout_height="128dp" android:background="@drawable/bg_reference_row">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="20dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Global Renderer" android:textColor="@color/cryonix_text" android:textSize="19sp"/>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Choose the renderer used by the launcher." android:textColor="@color/cryonix_text_secondary" android:textSize="14sp"/>
                            <TextView android:id="@+id/settings_global_renderer_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Selected: Krypton Wrapper" android:textColor="@color/cryonix_text_secondary" android:textSize="14sp"/>
                        </LinearLayout>
                        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="16dp" android:src="@drawable/ic_chevron_down" android:tint="@color/cryonix_icon"/>
                    </FrameLayout>
                    <FrameLayout android:id="@+id/settings_vulkan" android:layout_width="match_parent" android:layout_height="108dp" android:layout_marginTop="4dp" android:background="@drawable/bg_reference_row">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="20dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vulkan Driver" android:textColor="@color/cryonix_text" android:textSize="19sp"/>
                            <TextView android:id="@+id/settings_vulkan_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Selected: Turnip" android:textColor="@color/cryonix_text_secondary" android:textSize="14sp"/>
                        </LinearLayout>
                        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="16dp" android:src="@drawable/ic_chevron_down" android:tint="@color/cryonix_icon"/>
                    </FrameLayout>
                    <FrameLayout android:id="@+id/settings_graphics" android:layout_width="match_parent" android:layout_height="108dp" android:layout_marginTop="4dp" android:background="@drawable/bg_reference_row">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="20dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Graphics API" android:textColor="@color/cryonix_text" android:textSize="19sp"/>
                            <TextView android:id="@+id/settings_graphics_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Selected: Only set to OpenGL on first launch" android:textColor="@color/cryonix_text_secondary" android:textSize="14sp"/>
                        </LinearLayout>
                        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="16dp" android:src="@drawable/ic_chevron_down" android:tint="@color/cryonix_icon"/>
                    </FrameLayout>
                    <FrameLayout android:id="@+id/settings_resolution_rule" android:layout_width="match_parent" android:layout_height="108dp" android:layout_marginTop="4dp" android:background="@drawable/bg_reference_row">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="20dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Resolution Rule" android:textColor="@color/cryonix_text" android:textSize="19sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Selected: Percentage" android:textColor="@color/cryonix_text_secondary" android:textSize="14sp"/>
                        </LinearLayout>
                        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="16dp" android:src="@drawable/ic_chevron_down" android:tint="@color/cryonix_icon"/>
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/settings_section_game" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Game" android:textColor="@color/cryonix_text" android:textSize="20sp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Game version, loader, Java runtime and memory settings." android:textColor="@color/cryonix_text_secondary" android:textSize="14sp"/>
                    <TextView android:id="@+id/settings_game_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_reference_row" android:padding="20dp" android:text="Version: Automatic release   •   Loader: Vanilla   •   Memory: 2048 MB" android:textColor="@color/cryonix_text" android:textSize="15sp"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/settings_section_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Controls" android:textColor="@color/cryonix_text" android:textSize="20sp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_reference_row" android:padding="20dp" android:text="Touch controls and control layout configuration" android:textColor="@color/cryonix_text_secondary" android:textSize="15sp"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/settings_section_gamepad" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gamepad" android:textColor="@color/cryonix_text" android:textSize="20sp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_reference_row" android:padding="20dp" android:text="Gamepad mappings and input behavior" android:textColor="@color/cryonix_text_secondary" android:textSize="15sp"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/settings_section_launcher" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Launcher" android:textColor="@color/cryonix_text" android:textSize="20sp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_reference_row" android:padding="20dp" android:text="Launcher behavior, refresh, theme and home page options" android:textColor="@color/cryonix_text_secondary" android:textSize="15sp"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/settings_section_java" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Java" android:textColor="@color/cryonix_text" android:textSize="20sp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_reference_row" android:padding="20dp" android:text="Installed Java runtimes and runtime management" android:textColor="@color/cryonix_text_secondary" android:textSize="15sp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>