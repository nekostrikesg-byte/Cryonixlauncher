<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cryonix_background"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="76dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_reference_pill"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="10dp">

        <ImageButton
            android:id="@+id/settings_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            android:tint="@color/cryonix_icon"/>

        <ImageButton
            android:id="@+id/settings_home"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_reference_launch"
            android:contentDescription="Home"
            android:padding="12dp"
            android:src="@drawable/ic_home"
            android:tint="@color/cryonix_button_text"/>

        <View android:layout_width="42dp" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="@color/cryonix_divider"/>

        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="18dp" android:src="@drawable/ic_renderer" android:tint="@color/cryonix_accent_soft"/>
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="22dp" android:src="@drawable/ic_rocket" android:tint="@color/cryonix_icon"/>
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="22dp" android:src="@drawable/ic_gamepad" android:tint="@color/cryonix_icon"/>
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="22dp" android:src="@drawable/ic_cube" android:tint="@color/cryonix_icon"/>
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="22dp" android:src="@drawable/ic_java" android:tint="@color/cryonix_icon"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Settings"
                android:textColor="@color/cryonix_text"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <ImageButton android:id="@+id/settings_versions" android:layout_width="44dp" android:layout_height="44dp" android:background="@android:color/transparent" android:contentDescription="Instances" android:padding="10dp" android:src="@drawable/ic_cube" android:tint="@color/cryonix_icon"/>
            <ImageButton android:id="@+id/settings_accounts" android:layout_width="44dp" android:layout_height="44dp" android:background="@android:color/transparent" android:contentDescription="Accounts" android:padding="9dp" android:src="@drawable/ic_accounts" android:tint="@color/cryonix_icon"/>
            <ImageButton android:id="@+id/settings_download" android:layout_width="44dp" android:layout_height="44dp" android:background="@android:color/transparent" android:contentDescription="Downloads" android:padding="10dp" android:src="@drawable/ic_download" android:tint="@color/cryonix_icon"/>
        </LinearLayout>

        <ScrollView
            android:id="@+id/settings_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="12dp"
                android:paddingBottom="30dp">

                <TextView android:id="@+id/settings_nav_renderer" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="invisible"/>
                <TextView android:id="@+id/settings_section_renderer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Renderer" android:textColor="@color/cryonix_accent_soft" android:textSize="16sp" android:textStyle="bold"/>

                <FrameLayout android:id="@+id/settings_global_renderer" android:layout_width="match_parent" android:layout_height="88dp" android:layout_marginTop="8dp" android:background="@drawable/bg_reference_row" android:clickable="true" android:focusable="true">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="18dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Global Renderer" android:textColor="@color/cryonix_text" android:textSize="15sp"/>
                        <TextView android:id="@+id/settings_global_renderer_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Selected: Krypton Wrapper" android:textColor="@color/cryonix_text_secondary" android:textSize="12sp"/>
                    </LinearLayout>
                    <TextView android:layout_width="30dp" android:layout_height="match_parent" android:layout_gravity="end" android:gravity="center" android:text="›" android:textColor="@color/cryonix_text_secondary" android:textSize="28sp"/>
                </FrameLayout>

                <FrameLayout android:id="@+id/settings_vulkan" android:layout_width="match_parent" android:layout_height="76dp" android:layout_marginTop="6dp" android:background="@drawable/bg_reference_row" android:clickable="true">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="18dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vulkan Driver" android:textColor="@color/cryonix_text" android:textSize="15sp"/>
                        <TextView android:id="@+id/settings_vulkan_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Turnip" android:textColor="@color/cryonix_text_secondary" android:textSize="12sp"/>
                    </LinearLayout>
                    <TextView android:layout_width="30dp" android:layout_height="match_parent" android:layout_gravity="end" android:gravity="center" android:text="›" android:textColor="@color/cryonix_text_secondary" android:textSize="28sp"/>
                </FrameLayout>

                <FrameLayout android:id="@+id/settings_graphics" android:layout_width="match_parent" android:layout_height="76dp" android:layout_marginTop="6dp" android:background="@drawable/bg_reference_row" android:clickable="true">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="18dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Graphics API" android:textColor="@color/cryonix_text" android:textSize="15sp"/>
                        <TextView android:id="@+id/settings_graphics_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OpenGL" android:textColor="@color/cryonix_text_secondary" android:textSize="12sp"/>
                    </LinearLayout>
                    <TextView android:layout_width="30dp" android:layout_height="match_parent" android:layout_gravity="end" android:gravity="center" android:text="›" android:textColor="@color/cryonix_text_secondary" android:textSize="28sp"/>
                </FrameLayout>

                <FrameLayout android:id="@+id/settings_resolution_rule" android:layout_width="match_parent" android:layout_height="76dp" android:layout_marginTop="6dp" android:background="@drawable/bg_reference_row" android:clickable="true">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="18dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Resolution Rule" android:textColor="@color/cryonix_text" android:textSize="15sp"/>
                        <TextView android:id="@+id/settings_resolution_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Percentage · 100%" android:textColor="@color/cryonix_text_secondary" android:textSize="12sp"/>
                    </LinearLayout>
                    <TextView android:layout_width="30dp" android:layout_height="match_parent" android:layout_gravity="end" android:gravity="center" android:text="›" android:textColor="@color/cryonix_text_secondary" android:textSize="28sp"/>
                </FrameLayout>

                <TextView android:id="@+id/settings_nav_game" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="invisible"/>
                <TextView android:id="@+id/settings_section_game" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Game" android:textColor="@color/cryonix_accent_soft" android:textSize="16sp" android:textStyle="bold"/>

                <TextView android:id="@+id/settings_game_value" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="8dp" android:background="@drawable/bg_reference_row" android:gravity="center_vertical" android:paddingStart="18dp" android:text="Version: Automatic&#10;Loader: Vanilla    •    Memory: 2048 MB" android:textColor="@color/cryonix_text" android:textSize="13sp"/>

                <TextView android:id="@+id/settings_nav_controls" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="invisible"/>
                <TextView android:id="@+id/settings_section_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Controls" android:textColor="@color/cryonix_accent_soft" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginTop="8dp" android:background="@drawable/bg_reference_row" android:gravity="center_vertical" android:paddingStart="18dp" android:text="Touch controls&#10;Edit the on-screen control layout" android:textColor="@color/cryonix_text" android:textSize="13sp"/>

                <TextView android:id="@+id/settings_nav_gamepad" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="invisible"/>
                <TextView android:id="@+id/settings_section_gamepad" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Gamepad" android:textColor="@color/cryonix_accent_soft" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginTop="8dp" android:background="@drawable/bg_reference_row" android:gravity="center_vertical" android:paddingStart="18dp" android:text="Gamepad input&#10;Controller mappings and sensitivity" android:textColor="@color/cryonix_text" android:textSize="13sp"/>

                <TextView android:id="@+id/settings_nav_launcher" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="invisible"/>
                <TextView android:id="@+id/settings_section_launcher" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Launcher" android:textColor="@color/cryonix_accent_soft" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginTop="8dp" android:background="@drawable/bg_reference_row" android:gravity="center_vertical" android:paddingStart="18dp" android:text="Launcher behavior&#10;Refresh, theme and home options" android:textColor="@color/cryonix_text" android:textSize="13sp"/>

                <TextView android:id="@+id/settings_nav_java" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="invisible"/>
                <TextView android:id="@+id/settings_section_java" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Java" android:textColor="@color/cryonix_accent_soft" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:id="@+id/settings_java_value" android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginTop="8dp" android:background="@drawable/bg_reference_row" android:gravity="center_vertical" android:paddingStart="18dp" android:text="Java runtime&#10;Automatic runtime selection" android:textColor="@color/cryonix_text" android:textSize="13sp"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>