<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cryonix_background"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="168dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_pojav_row"
        android:orientation="vertical"
        android:padding="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="45dp" android:gravity="center_vertical">
            <ImageButton android:id="@+id/settings_back" android:layout_width="36dp" android:layout_height="36dp" android:background="@android:color/transparent" android:contentDescription="Back" android:padding="9dp" android:src="@drawable/ic_back" android:tint="@color/cryonix_icon"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="SETTINGS" android:textColor="@color/cryonix_text" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.1"/>
            <ImageButton android:id="@+id/settings_home" android:layout_width="34dp" android:layout_height="34dp" android:background="@android:color/transparent" android:contentDescription="Home" android:padding="8dp" android:src="@drawable/ic_home" android:tint="@color/cryonix_icon"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="4dp" android:layout_marginBottom="10dp" android:background="@color/cryonix_divider"/>
        <TextView android:layout_width="match_parent" android:layout_height="25dp" android:gravity="center_vertical" android:text="PREFERENCES" android:textColor="@color/cryonix_muted" android:textSize="8sp" android:textStyle="bold" android:letterSpacing="0.12"/>
        <TextView android:id="@+id/settings_sidebar_renderer" android:layout_width="match_parent" android:layout_height="38dp" android:background="@drawable/bg_pojav_button" android:drawableStart="@drawable/ic_renderer" android:drawablePadding="10dp" android:gravity="center_vertical" android:paddingStart="10dp" android:text="General" android:textColor="@color/cryonix_button_text" android:textSize="10sp"/>
        <TextView android:id="@+id/settings_sidebar_game" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="4dp" android:background="@android:color/transparent" android:drawableStart="@drawable/ic_rocket" android:drawablePadding="10dp" android:gravity="center_vertical" android:paddingStart="10dp" android:text="Game" android:textColor="@color/cryonix_text_secondary" android:textSize="10sp"/>
        <TextView android:id="@+id/settings_sidebar_controls" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="4dp" android:background="@android:color/transparent" android:drawableStart="@drawable/ic_gamepad" android:drawablePadding="10dp" android:gravity="center_vertical" android:paddingStart="10dp" android:text="Controls" android:textColor="@color/cryonix_text_secondary" android:textSize="10sp"/>
        <TextView android:id="@+id/settings_sidebar_launcher" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="4dp" android:background="@android:color/transparent" android:drawableStart="@drawable/ic_settings" android:drawablePadding="10dp" android:gravity="center_vertical" android:paddingStart="10dp" android:text="Advanced" android:textColor="@color/cryonix_text_secondary" android:textSize="10sp"/>
        <TextView android:id="@+id/settings_sidebar_java" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="4dp" android:background="@android:color/transparent" android:drawableStart="@drawable/ic_java" android:drawablePadding="10dp" android:gravity="center_vertical" android:paddingStart="10dp" android:text="Java runtime" android:textColor="@color/cryonix_text_secondary" android:textSize="10sp"/>
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="CRYONIX  ·  JAVA EDITION" android:textColor="@color/cryonix_muted" android:textSize="7sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Settings" android:textColor="@color/cryonix_text" android:textSize="20sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fine-tune how Cryonix looks and plays." android:textColor="@color/cryonix_text_secondary" android:textSize="9sp"/>
            </LinearLayout>
            <TextView android:layout_width="156dp" android:layout_height="34dp" android:background="@drawable/bg_pojav_row" android:gravity="center_vertical" android:paddingStart="10dp" android:text="⌕   Search settings" android:textColor="@color/cryonix_muted" android:textSize="9sp"/>
        </LinearLayout>

        <ScrollView android:id="@+id/settings_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="7dp" android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="6dp" android:paddingBottom="18dp">
                <TextView android:id="@+id/settings_nav_renderer" android:layout_width="1dp" android:layout_height="1dp" android:visibility="invisible"/>
                <TextView android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:text="OVERVIEW" android:textColor="@color/cryonix_muted" android:textSize="8sp" android:textStyle="bold" android:letterSpacing="0.12"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:id="@+id/settings_overview_general" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:background="@drawable/bg_pojav_row" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingStart="10dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:padding="5dp" android:src="@drawable/ic_renderer" android:tint="@color/cryonix_accent_soft"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="General" android:textColor="@color/cryonix_text" android:textSize="11sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Renderer and launcher" android:textColor="@color/cryonix_text_secondary" android:textSize="8sp"/></LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/settings_overview_game" android:layout_width="0dp" android:layout_height="58dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_pojav_row" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingStart="10dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:padding="5dp" android:src="@drawable/ic_rocket" android:tint="@color/cryonix_accent_soft"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Game" android:textColor="@color/cryonix_text" android:textSize="11sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Version and memory" android:textColor="@color/cryonix_text_secondary" android:textSize="8sp"/></LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/settings_overview_display" android:layout_width="0dp" android:layout_height="58dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_pojav_row" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingStart="10dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:padding="5dp" android:src="@drawable/ic_setting_video" android:tint="@color/cryonix_accent_soft"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Display" android:textColor="@color/cryonix_text" android:textSize="11sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Resolution and video" android:textColor="@color/cryonix_text_secondary" android:textSize="8sp"/></LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
                    <LinearLayout android:id="@+id/settings_overview_controls" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:background="@drawable/bg_pojav_row" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingStart="10dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:padding="5dp" android:src="@drawable/ic_gamepad" android:tint="@color/cryonix_accent_soft"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Controls" android:textColor="@color/cryonix_text" android:textSize="11sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Touch and gamepad" android:textColor="@color/cryonix_text_secondary" android:textSize="8sp"/></LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/settings_overview_advanced" android:layout_width="0dp" android:layout_height="58dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_pojav_row" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingStart="10dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:padding="5dp" android:src="@drawable/ic_settings" android:tint="@color/cryonix_accent_soft"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Advanced" android:textColor="@color/cryonix_text" android:textSize="11sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Launcher and runtime" android:textColor="@color/cryonix_text_secondary" android:textSize="8sp"/></LinearLayout>
                    </LinearLayout>
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                </LinearLayout>

                <TextView android:id="@+id/settings_section_renderer" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="10dp" android:gravity="center_vertical" android:text="General" android:textColor="@color/cryonix_text" android:textSize="13sp" android:textStyle="bold"/>
                <FrameLayout android:id="@+id/settings_global_renderer" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_pojav_row" android:clickable="true" android:paddingStart="10dp" android:paddingEnd="10dp"><LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Default renderer" android:textColor="@color/cryonix_text" android:textSize="10sp"/><TextView android:id="@+id/settings_global_renderer_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Selected: Krypton Wrapper" android:textColor="@color/cryonix_text_secondary" android:textSize="8sp"/></LinearLayout></FrameLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="4dp" android:orientation="horizontal">
                    <FrameLayout android:id="@+id/settings_vulkan" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_pojav_row" android:paddingStart="10dp"><TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:text="Vulkan driver" android:textColor="@color/cryonix_text" android:textSize="9sp"/><TextView android:id="@+id/settings_vulkan_value" android:layout_width="90dp" android:layout_height="match_parent" android:layout_gravity="end" android:gravity="center" android:text="Turnip" android:textColor="@color/cryonix_text_secondary" android:textSize="9sp"/></FrameLayout>
                    <FrameLayout android:id="@+id/settings_graphics" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="5dp" android:layout_weight="1" android:background="@drawable/bg_pojav_row" android:paddingStart="10dp"><TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:text="Graphics API" android:textColor="@color/cryonix_text" android:textSize="9sp"/><TextView android:id="@+id/settings_graphics_value" android:layout_width="90dp" android:layout_height="match_parent" android:layout_gravity="end" android:gravity="center" android:text="OpenGL" android:textColor="@color/cryonix_text_secondary" android:textSize="9sp"/></FrameLayout>
                </LinearLayout>

                <TextView android:id="@+id/settings_section_game" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="10dp" android:gravity="center_vertical" android:text="Game" android:textColor="@color/cryonix_text" android:textSize="13sp" android:textStyle="bold"/>
                <TextView android:id="@+id/settings_game_value" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/bg_pojav_row" android:gravity="center_vertical" android:paddingStart="10dp" android:text="Version: Current profile     ·     Loader: Vanilla     ·     Memory: Automatic" android:textColor="@color/cryonix_text_secondary" android:textSize="9sp"/>

                <TextView android:id="@+id/settings_section_gamepad" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="10dp" android:gravity="center_vertical" android:text="Display" android:textColor="@color/cryonix_text" android:textSize="13sp" android:textStyle="bold"/>
                <FrameLayout android:id="@+id/settings_resolution_rule" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/bg_pojav_row" android:paddingStart="10dp"><TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:text="Game resolution scale" android:textColor="@color/cryonix_text" android:textSize="9sp"/><TextView android:id="@+id/settings_resolution_value" android:layout_width="100dp" android:layout_height="match_parent" android:layout_gravity="end" android:gravity="center" android:text="100%" android:textColor="@color/cryonix_text_secondary" android:textSize="9sp"/></FrameLayout>

                <TextView android:id="@+id/settings_section_controls" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="10dp" android:gravity="center_vertical" android:text="Controls" android:textColor="@color/cryonix_text" android:textSize="13sp" android:textStyle="bold"/>
                <TextView android:id="@+id/settings_controls_screen" android:layout_width="match_parent" android:layout_height="46dp" android:background="@drawable/bg_pojav_row" android:gravity="center_vertical" android:paddingStart="10dp" android:text="Touch controls     ·     Configure on-screen controls" android:textColor="@color/cryonix_text" android:textSize="9sp"/>
                <TextView android:id="@+id/settings_gamepad_screen" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="4dp" android:background="@drawable/bg_pojav_row" android:gravity="center_vertical" android:paddingStart="10dp" android:text="Gamepad     ·     Configure connected controller" android:textColor="@color/cryonix_text" android:textSize="9sp"/>

                <TextView android:id="@+id/settings_section_launcher" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="10dp" android:gravity="center_vertical" android:text="Advanced" android:textColor="@color/cryonix_text" android:textSize="13sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/bg_pojav_row" android:gravity="center_vertical" android:paddingStart="10dp" android:text="Cursor Studio     ·     Pointer presets" android:textColor="@color/cryonix_text_secondary" android:textSize="9sp"/>
                <TextView android:id="@+id/settings_cursor_studio" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp" android:background="@drawable/bg_pojav_row" android:gravity="center_vertical" android:paddingStart="10dp" android:text="About Cryonix     ·     Version, project and credits" android:textColor="@color/cryonix_text_secondary" android:textSize="9sp"/>
                <TextView android:id="@+id/settings_about" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="gone"/>

                <TextView android:id="@+id/settings_section_java" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="10dp" android:gravity="center_vertical" android:text="Java runtime" android:textColor="@color/cryonix_text" android:textSize="13sp" android:textStyle="bold"/>
                <Switch android:id="@+id/settings_keep_screen_on" android:layout_width="match_parent" android:layout_height="42dp" android:text="Keep screen on while launcher is open" android:textColor="@color/cryonix_text" android:textSize="9sp"/>
                <Switch android:id="@+id/settings_cutout" android:layout_width="match_parent" android:layout_height="42dp" android:text="Use display cutout/notch area" android:textColor="@color/cryonix_text" android:textSize="9sp"/>
                <TextView android:id="@+id/settings_java_value" android:layout_width="match_parent" android:layout_height="42dp" android:background="@drawable/bg_pojav_row" android:gravity="center_vertical" android:paddingStart="10dp" android:text="Java runtime     ·     Automatic selection" android:textColor="@color/cryonix_text_secondary" android:textSize="9sp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
