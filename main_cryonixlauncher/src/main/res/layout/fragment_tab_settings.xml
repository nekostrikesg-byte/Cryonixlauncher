<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="26dp" android:text="Settings" android:textColor="@color/cryonix_text" android:textSize="17sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="22dp" android:text="Configure Cryonixlauncher and the Minecraft runtime." android:textColor="@color/cryonix_text_secondary" android:textSize="9sp" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:id="@+id/settings_tab_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
