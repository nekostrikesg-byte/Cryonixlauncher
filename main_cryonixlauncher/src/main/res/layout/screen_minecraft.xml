<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="24dp"
    android:background="@color/cryonix_background">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.25"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Minecraft"
            android:textColor="@color/cryonix_text"
            android:textSize="30sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/minecraft_selected_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Version: not selected"
            android:textColor="@color/cryonix_text_secondary"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/minecraft_selected_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Profile: Player"
            android:textColor="@color/cryonix_text_secondary"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/minecraft_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Ready"
            android:textColor="@color/cryonix_text"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/minecraft_play"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/cryonix_accent"
            android:text="Launch Minecraft"
            android:textAllCaps="false"
            android:textColor="@color/cryonix_button_text"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/minecraft_back"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/cryonix_surface"
            android:text="Back"
            android:textAllCaps="false"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="24dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Minecraft setup"
            android:textColor="@color/cryonix_text"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/minecraft_versions"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/cryonix_surface_alt"
            android:text="Versions"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/minecraft_accounts"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height"
            android:backgroundTint="@color/cryonix_surface_alt"
            android:text="Accounts"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/minecraft_loader"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height"
            android:backgroundTint="@color/cryonix_surface_alt"
            android:text="Loader"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/minecraft_renderer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height"
            android:backgroundTint="@color/cryonix_surface_alt"
            android:text="Renderer"
            android:textAllCaps="false"/>
    </LinearLayout>
</LinearLayout>