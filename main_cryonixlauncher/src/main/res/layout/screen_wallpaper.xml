<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding"
    android:background="@color/cryonix_background">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/wallpaper" android:textColor="@color/cryonix_text" android:textSize="28sp" android:textStyle="bold"/>
    <GridLayout
        android:id="@+id/wallpaper_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="2"
        android:layout_marginTop="18dp"/>
    <Button android:id="@+id/wallpaper_apply" android:layout_width="match_parent" android:layout_height="@dimen/control_height" android:text="Apply wallpaper" android:textAllCaps="false"/>
</LinearLayout>