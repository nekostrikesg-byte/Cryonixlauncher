<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/cryonix_background" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
<TextView android:id="@+id/new_instance_back" android:layout_width="70dp" android:layout_height="40dp" android:gravity="center" android:text="‹ Back" android:textColor="@color/cryonix_text" android:background="@drawable/bg_pojav_row"/>
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="New Instance" android:textColor="@color/cryonix_text" android:textSize="19sp" android:textStyle="bold"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Preview profile options. Existing profile data remains untouched from this setup screen." android:textColor="@color/cryonix_text_secondary" android:textSize="9sp"/>
<EditText android:id="@+id/new_instance_name" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="10dp" android:background="@drawable/bg_pojav_row" android:hint="Instance name" android:paddingStart="12dp" android:textColor="@color/cryonix_text" android:textColorHint="@color/cryonix_muted" android:singleLine="true"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingEnd="5dp" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="24dp" android:text="Minecraft version" android:textColor="@color/cryonix_text_secondary" android:textSize="9sp"/><Spinner android:id="@+id/new_instance_version" android:layout_width="match_parent" android:layout_height="42dp" android:background="@drawable/bg_pojav_row"/></LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="5dp" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="24dp" android:text="Loader" android:textColor="@color/cryonix_text_secondary" android:textSize="9sp"/><Spinner android:id="@+id/new_instance_loader" android:layout_width="match_parent" android:layout_height="42dp" android:background="@drawable/bg_pojav_row"/></LinearLayout>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingEnd="5dp" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="24dp" android:text="Loader version" android:textColor="@color/cryonix_text_secondary" android:textSize="9sp"/><Spinner android:id="@+id/new_instance_loader_version" android:layout_width="match_parent" android:layout_height="42dp" android:background="@drawable/bg_pojav_row"/></LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="5dp" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="24dp" android:text="Java runtime" android:textColor="@color/cryonix_text_secondary" android:textSize="9sp"/><TextView android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:paddingStart="12dp" android:text="Automatic (runtime manager not connected)" android:textColor="@color/cryonix_text" android:textSize="9sp" android:background="@drawable/bg_pojav_row"/></LinearLayout>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingEnd="5dp" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="24dp" android:text="RAM" android:textColor="@color/cryonix_text_secondary" android:textSize="9sp"/><Spinner android:id="@+id/new_instance_memory" android:layout_width="match_parent" android:layout_height="42dp" android:background="@drawable/bg_pojav_row"/></LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="5dp" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="24dp" android:text="Resolution" android:textColor="@color/cryonix_text_secondary" android:textSize="9sp"/><Spinner android:id="@+id/new_instance_resolution" android:layout_width="match_parent" android:layout_height="42dp" android:background="@drawable/bg_pojav_row"/></LinearLayout>
</LinearLayout>
<TextView android:id="@+id/new_instance_status" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="9dp" android:gravity="center_vertical" android:text="Loading metadata…" android:textColor="@color/cryonix_text_secondary" android:textSize="9sp"/>
<TextView android:id="@+id/new_instance_create" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="4dp" android:gravity="center" android:text="CREATE INSTANCE" android:textColor="@color/cryonix_button_text" android:textSize="11sp" android:background="@drawable/bg_pojav_button"/>
</LinearLayout></ScrollView>