<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cryonix_background"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="12dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <TextView android:id="@+id/instances_back" android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bg_cryonix_row" android:gravity="center" android:text="‹" android:textColor="@color/cryonix_icon" android:textSize="23sp" android:contentDescription="Back"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="11dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Instances" android:textColor="@color/cryonix_text" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your Minecraft profiles in one place" android:textColor="@color/cryonix_text_secondary" android:textSize="9sp"/>
        </LinearLayout>
        <TextView android:id="@+id/instances_add" android:layout_width="136dp" android:layout_height="36dp" android:background="@drawable/bg_cryonix_button" android:gravity="center" android:text="＋  NEW INSTANCE" android:textColor="@color/cryonix_button_text" android:textSize="9sp" android:textStyle="bold"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="7dp" android:background="@color/cryonix_divider"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="12dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:layout_width="205dp" android:layout_height="match_parent" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="15dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PROFILE LIBRARY" android:textColor="@color/cryonix_accent_soft" android:textSize="8sp" android:textStyle="bold" android:letterSpacing="0.1"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="One launcher.\nEvery playstyle." android:textColor="@color/cryonix_text" android:textSize="20sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Keep vanilla, modded and testing profiles organized. Select a profile to see its details." android:textColor="@color/cryonix_text_secondary" android:textSize="9sp"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:layout_marginBottom="10dp" android:background="@color/cryonix_divider"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PROFILE TYPE" android:textColor="@color/cryonix_muted" android:textSize="8sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="6dp" android:background="@drawable/bg_cryonix_row" android:gravity="center_vertical" android:paddingStart="10dp" android:text="▦   All profiles" android:textColor="@color/cryonix_text" android:textSize="9sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="4dp" android:background="@android:color/transparent" android:gravity="center_vertical" android:paddingStart="10dp" android:text="◇   Recent" android:textColor="@color/cryonix_text_secondary" android:textSize="9sp"/>
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Profiles are read from your existing launcher configuration." android:textColor="@color/cryonix_muted" android:textSize="8sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ALL PROFILES" android:textColor="@color/cryonix_text" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.1"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sort: Recently used  ▾" android:textColor="@color/cryonix_text_secondary" android:textSize="8sp"/>
            </LinearLayout>
            <TextView android:id="@+id/instances_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:background="@drawable/bg_cryonix_row" android:gravity="center" android:padding="16dp" android:text="No profiles found yet. Create one to get started." android:textColor="@color/cryonix_text_secondary" android:textSize="10sp"/>
            <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="5dp" android:layout_weight="1" android:scrollbars="none">
                <LinearLayout android:id="@+id/instances_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
