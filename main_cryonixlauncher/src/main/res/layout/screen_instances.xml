<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/cryonix_background" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center">
        <LinearLayout android:layout_width="330dp" android:layout_height="46dp" android:background="@drawable/bg_pojav_row" android:gravity="center" android:padding="4dp">
            <TextView android:id="@+id/instances_back" android:layout_width="52dp" android:layout_height="38dp" android:gravity="center" android:text="‹"
                android:textColor="@color/cryonix_icon" android:textSize="24sp"/>
            <ImageView android:layout_width="52dp" android:layout_height="38dp" android:background="@drawable/bg_pojav_button" android:padding="10dp" android:src="@drawable/ic_cube" android:tint="@color/cryonix_button_text"/>
            <ImageView android:layout_width="52dp" android:layout_height="38dp" android:padding="10dp" android:src="@drawable/ic_accounts" android:tint="@color/cryonix_icon"/>
            <ImageView android:layout_width="52dp" android:layout_height="38dp" android:padding="10dp" android:src="@drawable/ic_download" android:tint="@color/cryonix_icon"/>
            <ImageView android:layout_width="52dp" android:layout_height="38dp" android:padding="10dp" android:src="@drawable/ic_settings" android:tint="@color/cryonix_icon"/>
            <ImageView android:layout_width="52dp" android:layout_height="38dp" android:padding="10dp" android:src="@drawable/ic_home" android:tint="@color/cryonix_icon"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Instances" android:textColor="@color/cryonix_text" android:textSize="19sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Profiles, versions and launch presets" android:textColor="@color/cryonix_text_secondary" android:textSize="8sp"/>
        </LinearLayout>
        <TextView android:id="@+id/instances_add" android:layout_width="132dp" android:layout_height="36dp" android:background="@drawable/bg_pojav_button" android:gravity="center"
            android:text="+ NEW INSTANCE" android:textColor="@color/cryonix_button_text" android:textSize="9sp" android:textStyle="bold"/>
    </LinearLayout>
    <TextView android:id="@+id/instances_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:background="@drawable/bg_pojav_row" android:gravity="center" android:padding="16dp" android:text="No instances yet. Create one to show it on the launcher."
        android:textColor="@color/cryonix_text_secondary" android:textSize="10sp"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:scrollbars="none">
        <LinearLayout android:id="@+id/instances_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    </ScrollView>
</LinearLayout>