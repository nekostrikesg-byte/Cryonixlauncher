<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding"
    android:background="@color/cryonix_background">

    <ImageView android:id="@+id/app_icon" android:layout_width="72dp" android:layout_height="72dp" android:layout_gravity="center_horizontal" android:contentDescription="@string/app_info"/>
    <TextView android:id="@+id/app_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:textColor="@color/cryonix_text" android:textSize="22sp" android:textStyle="bold"/>
    <TextView android:id="@+id/app_package" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:textColor="@color/cryonix_text_secondary" android:textSize="13sp"/>

    <Button android:id="@+id/app_launch" android:layout_width="match_parent" android:layout_height="@dimen/control_height" android:layout_marginTop="@dimen/section_gap" android:text="Open" android:textAllCaps="false"/>
    <Button android:id="@+id/app_uninstall" android:layout_width="match_parent" android:layout_height="@dimen/control_height" android:text="Uninstall" android:textAllCaps="false"/>
</LinearLayout>