<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding"
    android:background="@color/cryonix_background">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widgets" android:textColor="@color/cryonix_text" android:textSize="28sp" android:textStyle="bold"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Choose useful information for your home screen." android:textColor="@color/cryonix_text_secondary"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/widget_picker"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"/>
</LinearLayout>