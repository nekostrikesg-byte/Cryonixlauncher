<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cryonix_background"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:background="@color/cryonix_top"
        android:paddingStart="8dp"
        android:paddingEnd="10dp">
        <ImageButton
            android:id="@+id/pojav_settings_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back to Cryonix settings"
            android:padding="9dp"
            android:src="@drawable/ic_back"
            android:tint="@color/cryonix_icon" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POJAV BACKEND"
                android:textColor="@color/cryonix_text"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Runtime settings · Cryonix interface"
                android:textColor="@color/cryonix_text_secondary"
                android:textSize="8sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/pojav_settings_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OVERVIEW"
            android:textColor="@color/cryonix_accent_soft"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/cryonix_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingTop="8dp">
        <LinearLayout
            android:layout_width="156dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_pojav_row"
            android:orientation="vertical"
            android:padding="8dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="center_vertical"
                android:text="BACKEND SECTIONS"
                android:textColor="@color/cryonix_muted"
                android:textSize="8sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
            <TextView android:id="@+id/pojav_nav_overview" style="@style/CryonixSettingsNav" android:text="Overview" android:drawableStart="@drawable/ic_settings" />
            <TextView android:id="@+id/pojav_nav_video" style="@style/CryonixSettingsNav" android:text="Video &amp; renderer" android:drawableStart="@drawable/ic_setting_video" />
            <TextView android:id="@+id/pojav_nav_controls" style="@style/CryonixSettingsNav" android:text="Controls" android:drawableStart="@drawable/ic_menu_custom_controls" />
            <TextView android:id="@+id/pojav_nav_java" style="@style/CryonixSettingsNav" android:text="Java &amp; memory" android:drawableStart="@drawable/ic_setting_java_runtime" />
            <TextView android:id="@+id/pojav_nav_misc" style="@style/CryonixSettingsNav" android:text="Miscellaneous" android:drawableStart="@drawable/ic_setting_misc" />
            <TextView android:id="@+id/pojav_nav_experimental" style="@style/CryonixSettingsNav" android:text="Experimental" android:drawableStart="@drawable/ic_settings" />
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="Changes apply to the Pojav runtime preferences."
                android:textColor="@color/cryonix_muted"
                android:textSize="7sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/pojav_settings_fragment_host"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@color/cryonix_background_2" />
    </LinearLayout>
</LinearLayout>
