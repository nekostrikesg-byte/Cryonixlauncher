<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- Activity and play-time column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.02"
        android:orientation="vertical"
        android:paddingEnd="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.08"
            android:background="@drawable/bg_cryonix_panel"
            android:orientation="vertical"
            android:padding="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_menu_news" android:tint="@color/cryonix_blue_bright" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_weight="1" android:text="Today's Activity" android:textColor="@color/cryonix_text" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginTop="7dp"
                android:text="PLAY TIME  ·  LAST 7 DAYS"
                android:textColor="@color/cryonix_muted"
                android:textSize="7sp"
                android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/home_week_activity"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sat" android:textColor="@color/cryonix_text_secondary" android:textSize="7sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.0" android:textColor="@color/cryonix_muted" android:textSize="7sp"/><View android:layout_width="22dp" android:layout_height="2dp" android:layout_marginTop="4dp" android:background="@color/cryonix_blue"/></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sun" android:textColor="@color/cryonix_text_secondary" android:textSize="7sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.0" android:textColor="@color/cryonix_muted" android:textSize="7sp"/><View android:layout_width="22dp" android:layout_height="2dp" android:layout_marginTop="4dp" android:background="@color/cryonix_blue"/></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mon" android:textColor="@color/cryonix_text_secondary" android:textSize="7sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.0" android:textColor="@color/cryonix_muted" android:textSize="7sp"/><View android:layout_width="22dp" android:layout_height="2dp" android:layout_marginTop="4dp" android:background="@color/cryonix_blue"/></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tue" android:textColor="@color/cryonix_text_secondary" android:textSize="7sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.0" android:textColor="@color/cryonix_muted" android:textSize="7sp"/><View android:layout_width="22dp" android:layout_height="2dp" android:layout_marginTop="4dp" android:background="@color/cryonix_blue"/></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wed" android:textColor="@color/cryonix_text_secondary" android:textSize="7sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.0" android:textColor="@color/cryonix_muted" android:textSize="7sp"/><View android:layout_width="22dp" android:layout_height="2dp" android:layout_marginTop="4dp" android:background="@color/cryonix_blue"/></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thu" android:textColor="@color/cryonix_text_secondary" android:textSize="7sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.0" android:textColor="@color/cryonix_muted" android:textSize="7sp"/><View android:layout_width="22dp" android:layout_height="2dp" android:layout_marginTop="4dp" android:background="@color/cryonix_blue"/></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fri" android:textColor="@color/cryonix_text_secondary" android:textSize="7sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0.0" android:textColor="@color/cryonix_muted" android:textSize="7sp"/><View android:layout_width="22dp" android:layout_height="2dp" android:layout_marginTop="4dp" android:background="@color/cryonix_blue"/></LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/bg_cryonix_nav" android:padding="8dp" android:src="@drawable/ic_rocket" android:tint="@color/cryonix_blue_bright" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Play Time" android:textColor="@color/cryonix_text" android:textSize="9sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Tracked after your first session" android:textColor="@color/cryonix_muted" android:textSize="7sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="0.92"
            android:background="@drawable/bg_cryonix_panel"
            android:orientation="vertical"
            android:padding="11dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/bg_cryonix_nav" android:padding="6dp" android:src="@drawable/ic_menu_home" android:tint="@color/cryonix_blue_bright" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:orientation="vertical">
                        <TextView android:id="@+id/home_playtime_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0 h" android:textColor="@color/cryonix_text" android:textSize="18sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Today" android:textColor="@color/cryonix_text_secondary" android:textSize="8sp" />
                    </LinearLayout>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:layout_marginBottom="9dp" android:background="@color/cryonix_divider" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_menu_news" android:tint="@color/cryonix_blue_bright" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:text="STATISTICS" android:textColor="@color/cryonix_text_secondary" android:textSize="8sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="Session statistics will appear here when available." android:textColor="@color/cryonix_muted" android:textSize="8sp" />
                <TextView android:id="@+id/home_activity_details" android:layout_width="wrap_content" android:layout_height="22dp" android:gravity="center_vertical" android:text="Click for more   ›" android:textColor="@color/cryonix_blue_bright" android:textSize="8sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- News and game-log column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.02"
        android:orientation="vertical"
        android:paddingStart="3dp"
        android:paddingEnd="3dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.04"
            android:background="@drawable/bg_cryonix_panel"
            android:orientation="vertical"
            android:padding="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_menu_news" android:tint="@color/cryonix_blue_bright" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_weight="1" android:text="Latest News" android:textColor="@color/cryonix_text" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/home_news_view_all" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="View all   ›" android:textColor="@color/cryonix_blue_bright" android:textSize="7sp" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="5dp" android:background="@color/cryonix_divider" />
            <LinearLayout
                android:id="@+id/home_news_profiles"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bg_cryonix_nav" android:padding="7dp" android:src="@drawable/ic_cube" android:tint="@color/cryonix_blue_bright" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Minecraft profiles" android:textColor="@color/cryonix_text" android:textSize="8sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Select versions and mod loaders" android:textColor="@color/cryonix_text_secondary" android:textSize="7sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/bg_cryonix_nav" android:paddingStart="6dp" android:paddingTop="2dp" android:paddingEnd="6dp" android:paddingBottom="2dp" android:text="OPEN" android:textColor="@color/cryonix_blue_bright" android:textSize="6sp" />
                </LinearLayout>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/cryonix_divider" />
            <LinearLayout
                android:id="@+id/home_news_settings"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bg_cryonix_nav" android:padding="7dp" android:src="@drawable/ic_renderer" android:tint="@color/cryonix_blue_bright" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Renderer and Java" android:textColor="@color/cryonix_text" android:textSize="8sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Tune graphics and runtime settings" android:textColor="@color/cryonix_text_secondary" android:textSize="7sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/bg_cryonix_nav" android:paddingStart="6dp" android:paddingTop="2dp" android:paddingEnd="6dp" android:paddingBottom="2dp" android:text="SETTINGS" android:textColor="@color/cryonix_blue_bright" android:textSize="6sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="0.96"
            android:background="@drawable/bg_cryonix_panel"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_file" android:tint="@color/cryonix_blue_bright" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:text="Last Game Log" android:textColor="@color/cryonix_text" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="34dp" android:layout_height="34dp" android:alpha="0.65" android:src="@drawable/ic_file" android:tint="@color/cryonix_muted" />
                <TextView android:id="@+id/home_log_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="No log available yet" android:textColor="@color/cryonix_text_secondary" android:textSize="8sp" />
                <TextView android:id="@+id/home_log_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="Start a game to see its latest log here." android:textColor="@color/cryonix_muted" android:textSize="7sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Selected account, current profile and launch actions -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.98"
        android:orientation="vertical"
        android:paddingStart="4dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_cryonix_panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
                android:padding="8dp">
            <ImageView
                android:id="@+id/home_account_avatar"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="1dp"
                android:background="@drawable/bg_cryonix_avatar"
                android:clipToOutline="true"
                android:padding="8dp"
                android:src="@drawable/cryonix_logo" />
            <TextView
                android:id="@+id/home_current_account"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:gravity="center"
                android:text="Select an account"
                android:textColor="@color/cryonix_text"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/home_account_status"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginTop="1dp"
                android:background="@drawable/bg_cryonix_nav"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Offline"
                android:textColor="@color/cryonix_text_secondary"
                android:textSize="7sp" />

            <LinearLayout
                android:id="@+id/home_instance_row"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_cryonix_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="6dp">
                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_grass_block" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CURRENT INSTANCE" android:textColor="@color/cryonix_text_secondary" android:textSize="6sp" />
                    <TextView android:id="@+id/home_instance_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:text="Default profile" android:textColor="@color/cryonix_text" android:textSize="8sp" android:textStyle="bold" />
                    <TextView android:id="@+id/home_instance_version" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:ellipsize="end" android:maxLines="1" android:text="Choose a Minecraft version" android:textColor="@color/cryonix_muted" android:textSize="7sp" />
                </LinearLayout>
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron_down" android:rotation="-90" android:tint="@color/cryonix_blue_bright" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/home_launch_game"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_cryonix_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_rocket" android:tint="@color/cryonix_button_text" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:letterSpacing="0.06" android:text="LAUNCH" android:textColor="@color/cryonix_button_text" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:id="@+id/home_launch_status"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:gravity="center"
                android:text="Ready to launch"
                android:textColor="@color/cryonix_text_secondary"
                android:textSize="7sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="1dp" android:orientation="horizontal">
                <LinearLayout android:id="@+id/home_discord" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_cryonix_row" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="6dp">
                    <ImageView android:layout_width="25dp" android:layout_height="25dp" android:background="@drawable/bg_cryonix_nav" android:padding="5dp" android:src="@drawable/ic_discord" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Discord" android:textColor="@color/cryonix_text" android:textSize="7sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Join community" android:textColor="@color/cryonix_muted" android:textSize="6sp"/></LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/home_directory" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="5dp" android:layout_weight="1" android:background="@drawable/bg_cryonix_row" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="6dp">
                    <ImageView android:layout_width="25dp" android:layout_height="25dp" android:background="@drawable/bg_cryonix_nav" android:padding="5dp" android:src="@drawable/ic_folder_simple" android:tint="@color/cryonix_blue_bright" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Game files" android:textColor="@color/cryonix_text" android:textSize="7sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Open folder" android:textColor="@color/cryonix_muted" android:textSize="6sp"/></LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
