<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:text="CRYONIXLAUNCHER"
        android:textColor="@color/cryonix_text"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:text="Minecraft Java Edition"
        android:textColor="@color/cryonix_text_secondary"
        android:textSize="9sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="9dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.45"
            android:background="@color/cryonix_surface"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:text="GAME PROFILE"
                android:textColor="@color/cryonix_accent_soft"
                android:textSize="8sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />
            <TextView
                android:id="@+id/home_current_account"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:gravity="center_vertical"
                android:text="No account selected"
                android:textColor="@color/cryonix_text"
                android:textSize="12sp"
                android:textStyle="bold" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:background="@color/cryonix_divider" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:text="MINECRAFT VERSION"
                android:textColor="@color/cryonix_muted"
                android:textSize="8sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <com.kdt.mcgui.mcVersionSpinner
                    android:id="@+id/mc_version_spinner"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    app:drawableEndSize="@dimen/_12sdp"
                    app:drawableStartSize="@dimen/_36sdp" />
                <ImageButton
                    android:id="@+id/edit_profile_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_cryonix_row"
                    android:contentDescription="Edit selected game profile"
                    android:padding="10dp"
                    android:src="@drawable/ic_edit_profile"
                    android:tint="@color/cryonix_icon" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <Button
                android:id="@+id/home_launch_game"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="@color/cryonix_blue"
                android:text="PLAY"
                android:textColor="@color/cryonix_button_text"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/home_launch_status"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="Ready to launch"
                android:textColor="@color/cryonix_text_secondary"
                android:textSize="9sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/home_instances"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_cryonix_row"
                    android:gravity="center"
                    android:text="Instances"
                    android:textColor="@color/cryonix_text"
                    android:textSize="9sp" />
                <TextView
                    android:id="@+id/home_downloads"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_cryonix_row"
                    android:gravity="center"
                    android:text="Downloads"
                    android:textColor="@color/cryonix_text"
                    android:textSize="9sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/home_directory"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="5dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="Open game folder"
                android:textColor="@color/cryonix_text_secondary"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
