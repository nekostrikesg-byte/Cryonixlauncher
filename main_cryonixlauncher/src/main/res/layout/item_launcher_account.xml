<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">
    <TextView
        android:id="@+id/launcher_account_name"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:textColor="@color/cryonix_text"
        android:textSize="11sp" />
    <TextView
        android:id="@+id/launcher_account_active"
        android:layout_width="72dp"
        android:layout_height="26dp"
        android:gravity="center"
        android:text="ACTIVE"
        android:textColor="@color/cryonix_accent_soft"
        android:textSize="8sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/launcher_account_remove"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:gravity="center"
        android:text="×"
        android:textColor="@color/cryonix_text_secondary"
        android:textSize="17sp" />
</LinearLayout>
