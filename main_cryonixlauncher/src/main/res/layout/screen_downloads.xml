<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp" android:background="@color/cryonix_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center">
<LinearLayout android:layout_width="330dp" android:layout_height="46dp" android:background="@drawable/bg_pojav_row" android:gravity="center" android:padding="4dp">
<TextView android:id="@+id/downloads_back" android:layout_width="52dp" android:layout_height="38dp" android:gravity="center" android:text="‹" android:textColor="@color/cryonix_icon" android:textSize="24sp"/>
<ImageView android:layout_width="52dp" android:layout_height="38dp" android:padding="10dp" android:src="@drawable/ic_cube" android:tint="@color/cryonix_icon"/>
<ImageView android:layout_width="52dp" android:layout_height="38dp" android:padding="10dp" android:src="@drawable/ic_accounts" android:tint="@color/cryonix_icon"/>
<ImageView android:layout_width="52dp" android:layout_height="38dp" android:background="@drawable/bg_pojav_button" android:padding="10dp" android:src="@drawable/ic_download" android:tint="@color/cryonix_button_text"/>
<ImageView android:layout_width="52dp" android:layout_height="38dp" android:padding="10dp" android:src="@drawable/ic_settings" android:tint="@color/cryonix_icon"/>
<ImageView android:layout_width="52dp" android:layout_height="38dp" android:padding="10dp" android:src="@drawable/ic_home" android:tint="@color/cryonix_icon"/>
</LinearLayout></LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Downloads &amp; Tasks" android:textColor="@color/cryonix_text" android:textSize="20sp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Official Minecraft metadata, verified files and task progress" android:textColor="@color/cryonix_text_secondary" android:textSize="8sp"/>
<TextView android:id="@+id/downloads_status" android:layout_width="match_parent" android:layout_height="82dp" android:layout_marginTop="12dp" android:background="@drawable/bg_pojav_row" android:gravity="center_vertical" android:padding="14dp" android:text="No active downloads" android:textColor="@color/cryonix_text" android:textSize="11sp"/>
<ProgressBar android:id="@+id/downloads_progress" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="9dp" android:visibility="gone" style="?android:attr/progressBarStyleHorizontal"/>
<TextView android:id="@+id/downloads_install" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" android:gravity="center"
android:text="INSTALL SELECTED MINECRAFT" android:textColor="@color/cryonix_button_text" android:background="@drawable/bg_pojav_button" android:textSize="9sp"/>
<TextView android:id="@+id/downloads_refresh" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="7dp" android:gravity="center"
android:text="REFRESH OFFICIAL METADATA" android:textColor="@color/cryonix_text" android:background="@drawable/bg_pojav_row" android:textSize="9sp"/>
</LinearLayout>