<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cryonix_background"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical">
        <ImageButton
            android:id="@+id/about_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="9dp"
            android:src="@drawable/ic_back"
            android:tint="@color/cryonix_icon" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="About Cryonixlauncher"
            android:textColor="@color/cryonix_text"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="18dp">
            <ImageView android:layout_width="58dp" android:layout_height="58dp" android:src="@drawable/cryonix_logo" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Cryonixlauncher" android:textColor="@color/cryonix_text" android:textSize="19sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Minecraft Java Edition for Android" android:textColor="@color/cryonix_text_secondary" android:textSize="9sp" />
            <TextView android:id="@+id/about_version" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="10dp" android:gravity="center_vertical" android:text="Version" android:textColor="@color/cryonix_text_secondary" android:textSize="9sp" />
        </LinearLayout>
        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/cryonix_divider" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="About Cryonix" android:textColor="@color/cryonix_text" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="A practical landscape launcher for Minecraft Java Edition, with profiles, accounts, downloads, Java runtimes and renderer options." android:textColor="@color/cryonix_text_secondary" android:textSize="9sp" />
            <TextView android:id="@+id/about_github" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="12dp" android:background="@drawable/bg_cryonix_button" android:gravity="center" android:text="OPEN PROJECT PAGE" android:textColor="@color/cryonix_button_text" android:textSize="9sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Credits and licenses\nCryonixlauncher contributors. Minecraft and Microsoft are trademarks of their respective owners. The integrated open-source runtime retains its upstream licenses and notices." android:textColor="@color/cryonix_text_secondary" android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
