<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="@dimen/screen_padding"
    android:background="@color/cryonix_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="CRYONIX"
        android:textColor="@color/cryonix_accent"
        android:textSize="36sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Launcher"
        android:textColor="@color/cryonix_text"
        android:textSize="18sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="A clean, focused Android home experience built around the Cryonix brand."
        android:textColor="@color/cryonix_text_secondary"
        android:textSize="15sp"/>

    <TextView android:id="@+id/about_version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/version" android:textColor="@color/cryonix_text_secondary"/>
    <Button android:id="@+id/about_privacy" android:layout_width="match_parent" android:layout_height="@dimen/control_height" android:layout_marginTop="@dimen/section_gap" android:text="@string/privacy" android:textAllCaps="false"/>
</LinearLayout>