<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/cryonix_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
<TextView android:id="@+id/about_back" android:layout_width="70dp" android:layout_height="40dp" android:gravity="center" android:text="‹ Back" android:textColor="@color/cryonix_text" android:background="@drawable/bg_reference_pill"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="CRYONIX" android:textColor="@color/cryonix_accent" android:textSize="32sp" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Minecraft Launcher" android:textColor="@color/cryonix_text" android:textSize="16sp"/>
<TextView android:id="@+id/about_version" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="16dp" android:gravity="center_vertical" android:paddingStart="12dp" android:background="@drawable/bg_reference_row" android:text="Version" android:textColor="@color/cryonix_text_secondary" android:textSize="10sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Cryonix is an Android Minecraft launcher layer focused on persistent instances, official metadata, renderer profiles and a clean mobile-landscape workflow." android:textColor="@color/cryonix_text_secondary" android:textSize="10sp"/>
<TextView android:id="@+id/about_github" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="12dp" android:gravity="center" android:text="OPEN GITHUB PROJECT" android:textColor="@color/cryonix_button_text" android:background="@drawable/bg_reference_launch" android:textSize="10sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Credits\nCryonix Launcher contributors\nMinecraft and Microsoft are trademarks of their respective owners. Cryonix is not affiliated with Mojang or Microsoft." android:textColor="@color/cryonix_text_secondary" android:textSize="9sp"/>
</LinearLayout>
</ScrollView>